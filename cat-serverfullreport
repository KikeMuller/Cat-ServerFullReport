# =============================================================================
# REGION: COLECTORES (3 de prueba, sobre las ~15-17 planeadas para el MVP)
# =============================================================================

recolectar_sistema_operativo() {
  local id="1.1" archivo="$TMPDIR_TRABAJO/sec_1_1.tsv"
  local uptime_txt
  # uptime viene de procps y SI trae cadenas traducibles ("up 4 weeks" ->
  # "hace 4 semanas" con el language pack instalado). Va por
  # ejecutar_comando para heredar LC_ALL=C como el resto.
  uptime_txt="$(ejecutar_comando 5 uptime -p 2>/dev/null || ejecutar_comando 5 uptime 2>/dev/null || echo desconocido)"

  {
    printf 'Hostname\tSistemaOperativo\tKernel\tArquitectura\tUptime\n'
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$(tsv_escape "${CAPS[hostname]:-desconocido}")" \
      "$(tsv_escape "${CAPS[os_nombre]:-desconocido}")" \
      "$(tsv_escape "${CAPS[kernel]:-desconocido}")" \
      "$(tsv_escape "${CAPS[arquitectura]:-desconocido}")" \
      "$(tsv_escape "$uptime_txt")"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Sistema Operativo y Kernel" \
    "Identificacion basica del equipo: distribucion, version de kernel, arquitectura y tiempo desde el ultimo arranque." \
    "$archivo"
}

recolectar_servicios() {
  local id="1.2" archivo="$TMPDIR_TRABAJO/sec_1_2.tsv"

  if [ "${CAPS[init]:-otro}" != "systemd" ]; then
    agregar_seccion_mensaje "$id" "Servicios (systemd)" \
      "Servicios administrados por systemd, con su estado de carga y ejecucion." \
      "Este equipo no usa systemd como sistema de init detectado; la recoleccion de servicios via systemctl no aplica."
    return 0
  fi

  local salida
  if ! salida="$(ejecutar_comando 20 systemctl list-units --type=service --all --no-legend --no-pager --plain 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Servicios (systemd)" \
      "Servicios administrados por systemd, con su estado de carga y ejecucion." \
      "No se pudo consultar systemctl (comando ausente, timeout agotado o permisos insuficientes)."
    return 0
  fi

  {
    printf 'Unidad\tCarga\tActivo\tSubestado\tDescripcion\n'
    # OJO: el split original exigia 2+ espacios como separador (-F'  +'),
    # asumiendo que systemctl siempre deja un padding generoso entre
    # columnas. Falso: el ancho de cada columna se ajusta al valor MAS
    # LARGO presente en ESA corrida especifica, y cuando el subestado de
    # una fila (ej. "running") coincide con ese ancho maximo, el padding
    # real se reduce a UN SOLO espacio -- por ejemplo "...active   running
    # Accounts Service" tiene 1 espacio entre "running" y "Accounts", pero
    # "...active   exited  Load AppArmor profiles" tiene 2 entre "exited" y
    # "Load". Con -F'  +' esas filas con un solo espacio de separacion
    # fusionaban Subestado y el inicio de Descripcion en un solo campo,
    # dejando la columna Descripcion vacia. Se detecto viendo el reporte
    # renderizado, no en una prueba aislada -- la fila afectada dependia de
    # que unidad tuviera el subestado mas largo en ESE equipo especifico.
    #
    # Fix: split por defecto de awk (CUALQUIER cantidad de espacio en
    # blanco es un separador). Es seguro aca porque Unidad/Carga/Activo/
    # Subestado son siempre tokens unicos de systemd sin espacios internos;
    # solo Descripcion puede tener espacios, y ya se reconstruye
    # concatenando desde el campo 5 en adelante sin importar cuantos
    # campos ocupe.
    printf '%s\n' "$salida" | awk 'BEGIN{OFS="\t"} NF>=4 {
      unidad=$1; carga=$2; activo=$3; subest=$4
      desc = ""
      for (i = 5; i <= NF; i++) { desc = desc (i > 5 ? " " : "") $i }
      print unidad, carga, activo, subest, desc
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Servicios (systemd)" \
    "Servicios administrados por systemd, con su estado de carga y ejecucion. Un servicio 'failed' suele ser el primer sintoma de un problema." \
    "$archivo"
}

recolectar_disco() {
  local id="1.3" archivo="$TMPDIR_TRABAJO/sec_1_3.tsv"

  local salida
  if ! salida="$(ejecutar_comando 15 df -kP -x tmpfs -x devtmpfs -x squashfs -x overlay -x none 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Uso de Disco (Sistemas de Archivos)" \
      "Ocupacion de cada sistema de archivos montado: total, usado, libre y porcentaje." \
      "No se pudo ejecutar 'df' en este equipo."
    return 0
  fi

  {
    printf 'PuntoMontaje\tSistemaArchivos\tTotalKB\tUsadoKB\tLibreKB\tUsoPct\n'
    # El campo "sistema de archivos" (fs) puede tener espacios en montajes
    # exoticos (ej. rutas de Windows bajo WSL/drvfs), asi que no se puede
    # asumir que es siempre $1. Se ubica el bloque de 4 campos numericos
    # consecutivos (total, usado, libre, pct%) como ancla, y todo lo que
    # queda a los lados de ese bloque es fs / punto de montaje.
    printf '%s\n' "$salida" | awk 'NR>1 {
      idx = 0
      for (i = 2; i <= NF - 3; i++) {
        if ($i ~ /^[0-9]+$/ && $(i+1) ~ /^[0-9]+$/ && $(i+2) ~ /^[0-9]+$/ && $(i+3) ~ /^[0-9]+%$/) {
          idx = i
          break
        }
      }
      if (idx == 0) { next }
      fs = $1
      for (j = 2; j < idx; j++) { fs = fs " " $j }
      total = $idx; usado = $(idx+1); libre = $(idx+2); pct = $(idx+3)
      punto = $(idx+4)
      for (j = idx+5; j <= NF; j++) { punto = punto " " $j }
      print punto "\t" fs "\t" total "\t" usado "\t" libre "\t" pct
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Uso de Disco (Sistemas de Archivos)" \
    "Ocupacion de cada sistema de archivos montado: total, usado, libre y porcentaje. Un volumen por encima del 80% suele necesitar planificacion de espacio." \
    "$archivo"
}

# =============================================================================
# REGION: MOTOR DE HALLAZGOS (1 regla de prueba, sobre las ~10-15 planeadas)
# =============================================================================
#
# Misma disciplina que la version Windows: si no hay datos usables, no se
# afirma nada -- ni un hallazgo negativo, ni un OK. Ver CONTRIBUTING.md del
# proyecto hermano: "un OK falso es peor que el silencio".

motor_hallazgos_basico() {
  local archivo="${SEC_DATAFILE[1.3]:-}"

  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    # La seccion 1.3 no existe o no tiene datos: el topico queda en silencio,
    # no se emite ni CRIT/WARN ni el OK de "todo bien".
    return 0
  fi

  local hubo_hallazgo=0
  local linea_num=0
  local punto fs total_kb usado_kb libre_kb pct

  while IFS=$'\t' read -r punto fs total_kb usado_kb libre_kb pct; do
    linea_num=$((linea_num + 1))
    [ "$linea_num" -eq 1 ] && continue   # encabezado

    [ -z "${pct:-}" ] && continue

    # Un sistema de archivos montado de solo lectura (snap/squashfs, por
    # ejemplo) siempre reporta 100%% de uso por diseno: no hay "espacio a
    # liberar" porque nunca se puede escribir ahi. Evaluarlo como los demas
    # producia falsos CRIT sistematicos en cualquier Ubuntu con snapd
    # (snap monta cada paquete como una imagen de solo lectura llena al
    # 100%%). Mirror del principio de Get-VolumenesStorageExcluidos en la
    # version Windows: no afirmar sobre un dato que estructuralmente no
    # aplica.
    # findmnt con timeout A PROPOSITO: sobre un montaje NFS cuyo servidor
    # dejo de responder, findmnt se queda colgado en el syscall hasta que el
    # montaje expire (con hard,nointr: para siempre). Sin timeout, un solo
    # NFS caido cuelga el reporte COMPLETO, porque esto corre dentro de un
    # bucle que recorre cada punto de montaje. Si expira, opciones_montaje
    # queda vacio, no matchea "ro" y el montaje se evalua como cualquier
    # otro: se pierde la exclusion de solo-lectura, no los datos.
    if [ "${CAPS[findmnt]:-0}" = "1" ]; then
      local opciones_montaje
      opciones_montaje="$(ejecutar_comando 5 findmnt -no OPTIONS "$punto" 2>/dev/null)"
      case "$opciones_montaje" in
        ro|ro,*) continue ;;
      esac
    fi
    local pct_num="${pct%\%}"
    case "$pct_num" in
      ''|*[!0-9]*) continue ;;   # valor no numerico: no se puede evaluar, no se afirma nada
    esac

    if [ "$pct_num" -ge 90 ]; then
      agregar_hallazgo "CRIT" "Storage" "Punto de montaje $punto con espacio critico" \
        "Uso: ${pct} (${libre_kb} KB libres de ${total_kb} KB totales)" \
        "Liberar espacio o expandir el volumen de inmediato." \
        "ISO 27001 A.8.6" "1.3"
      hubo_hallazgo=1
    elif [ "$pct_num" -ge 80 ]; then
      agregar_hallazgo "WARN" "Storage" "Punto de montaje $punto con poco espacio libre" \
        "Uso: ${pct} (${libre_kb} KB libres de ${total_kb} KB totales)" \
        "Planificar liberacion de espacio o ampliacion." \
        "ISO 27001 A.8.6" "1.3"
      hubo_hallazgo=1
    fi
  done < "$archivo"

  if [ "$hubo_hallazgo" -eq 0 ]; then
    agregar_hallazgo "OK" "Storage" "Espacio libre en disco" "" \
      "Todos los sistemas de archivos relevados tienen uso por debajo del 80%." "ISO 27001 A.8.6" "1.3"
  fi
}

# =============================================================================
# REGION: RENDER (reusa el CSS/JS de arriba, mismo lenguaje visual)
# =============================================================================
#
# NOTA DE ALCANCE: este render es deliberadamente mas simple que el de la
# version Windows todavia. Formatea celdas como texto escapado plano, sin
# las heuristicas de Format-CellValue (badges de estado, medidores de
# porcentaje, mono para rutas/IPs, truncado de texto largo). Esa capa se
# porta en el siguiente pase, una vez validado que el esqueleto entero
# funciona de punta a punta.

bloque_mensaje() {
  html_escapar_var "$1"
  printf '<div class="msg"><span class="msg-icon" aria-hidden="true">&#8505;</span><p>%s</p></div>' "$HTML_ESC"
}

estado_vacio() {
  html_escapar_var "${1:-Sin datos disponibles.}"
  printf '<div class="empty-state"><span class="empty-icon" aria-hidden="true">&#8709;</span><p>%s</p></div>' "$HTML_ESC"
}

tabla_html_desde_tsv() {
  # tabla_html_desde_tsv <archivo_tsv> <id_html_tabla>
  local archivo="$1" id_tabla="$2"

  if [ ! -s "$archivo" ]; then
    estado_vacio
    return 0
  fi

  local total_filas=$(( $(wc -l < "$archivo") - 1 ))
  if [ "$total_filas" -le 0 ]; then
    estado_vacio
    return 0
  fi

  local columnas=() _linea_enc
  IFS= read -r _linea_enc < "$archivo"
  dividir_tsv "$_linea_enc"
  columnas=("${CAMPOS[@]}")

  printf '<div class="table-wrap"><table class="data-table" id="%s" data-total-rows="%d"><thead><tr>' \
    "$id_tabla" "$total_filas"

  # Tipo de enmascarado por columna, calculado UNA vez por tabla y no por
  # celda. Con --redact desactivado esto igual se calcula, pero
  # enmascarar_valor sale de inmediato y no cuesta nada medible.
  local tipos_col=() c_nombre
  for c_nombre in "${columnas[@]}"; do
    tipo_columna "$c_nombre"
    tipos_col+=("$TIPO_COL")
  done

  local i=0 c
  for c in "${columnas[@]}"; do
    html_escapar_var "$c"
    printf '<th data-col="%d" data-type="text" aria-sort="none" tabindex="0" role="columnheader"><span class="th-label">%s</span><span class="sort-ind" aria-hidden="true"></span></th>' \
      "$i" "$HTML_ESC"
    i=$((i + 1))
  done
  printf '</tr></thead><tbody>'

  local linea_num=0 _linea
  while IFS= read -r _linea; do
    linea_num=$((linea_num + 1))
    [ "$linea_num" -eq 1 ] && continue
    # dividir_tsv en vez de "read -r -a": preserva las celdas vacias. Sin
    # esto, una fila con un valor vacio en el medio corre todas las celdas
    # siguientes una columna a la izquierda, y el valor termina bajo el
    # encabezado equivocado sin que se note.
    dividir_tsv "$_linea"
    printf '<tr>'
    local celda idx=0
    for celda in "${CAMPOS[@]}"; do
      if [ "${REDACT:-0}" = "1" ]; then
        enmascarar_valor "$celda" "${tipos_col[$idx]:-ninguno}"
        celda="$VALOR_ENMASCARADO"
      fi
      # html_escapar_var (sin subshell) a proposito: este es el bucle mas
      # caliente del script, una vuelta por celda de cada tabla del reporte.
      html_escapar_var "$celda"
      printf '<td>%s</td>' "$HTML_ESC"
      idx=$((idx + 1))
    done
    printf '</tr>'
  done < "$archivo"

  printf '</tbody></table></div>'
}

construir_sidebar() {
  local hostname="${CAPS[hostname]:-EQUIPO}"
  printf '<nav class="sidebar" id="sidebar" aria-label="Tabla de contenidos"><div class="sidebar-host">%s</div>' \
    "$(html_escapar "$hostname")"
  printf '<input type="text" id="toc-filter" class="toc-filter-input" placeholder="Filtrar secciones..." aria-label="Filtrar secciones del indice">'
  printf '<div class="toc-scroll"><a href="#sec-resumen-hallazgos" class="toc-link toc-link-summary" data-target="sec-resumen-hallazgos">&#9873; Resumen de Hallazgos</a>'
  printf '<ul class="toc-list" data-depth="0">'

  # Este bucle usaba "$(... | sed ...)" y "$(... | tr ...)" por seccion, o sea
  # un fork + un exec de sed/tr por vuelta, para dos transformaciones que
  # bash 4 hace nativo: ${var//[^A-Za-z0-9]/-} y ${var,,}. Como el script ya
  # exige bash 4 (ver la validacion de BASH_MAYOR al inicio), ambas estan
  # garantizadas. Medido en WSL: construir_sidebar bajo de ~12s a decimas.
  local id
  for id in "${SECTION_ORDER[@]}"; do
    local anchor="sec-${id//[^A-Za-z0-9]/-}"
    local titulo="${SEC_TITLE[$id]}"
    local rowcount="${SEC_ROWCOUNT[$id]}"
    local badge=""
    [ "$rowcount" -gt 0 ] && badge="<span class=\"toc-count\">$rowcount</span>"
    local toctexto="${id} ${titulo}"
    toctexto="${toctexto,,}"
    html_escapar_var "$toctexto"; local esc_toc="$HTML_ESC"
    html_escapar_var "$id";       local esc_id="$HTML_ESC"
    html_escapar_var "$titulo";   local esc_tit="$HTML_ESC"
    printf '<li class="toc-item" data-toc-text="%s"><a href="#%s" class="toc-link" data-target="%s"><span class="toc-id">%s</span><span class="toc-title">%s</span>%s</a></li>' \
      "$esc_toc" "$anchor" "$anchor" "$esc_id" "$esc_tit" "$badge"
  done

  printf '</ul></div></nav>'
}

construir_topbar() {
  local puntaje="$1" hostname="$2"
