recolectar_paquetes() {
  local id="1.6" archivo="$TMPDIR_TRABAJO/sec_1_6.tsv"

  local gestor="${CAPS[pkg_manager]:-}"
  if [ -z "$gestor" ]; then
    agregar_seccion_mensaje "$id" "Paquetes Instalados" \
      "Paquetes instalados via el gestor de paquetes del sistema, con su version." \
      "No se detecto un gestor de paquetes conocido (dnf/yum/apt/zypper/apk/pacman) en este equipo."
    return 0
  fi

  local salida
  case "$gestor" in
    dnf|yum)
      # No probado en vivo contra un RHEL/Fedora real en esta sesion (los
      # dos equipos de prueba disponibles son Debian/Ubuntu); el formato de
      # --queryformat esta documentado y es estable, pero queda pendiente
      # de verificar contra un RPM real.
      salida="$(ejecutar_comando 30 rpm -qa --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\n' 2>/dev/null)"
      ;;
    apt|apt-get)
      salida="$(ejecutar_comando 30 dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null)"
      ;;
    zypper)
      # Tampoco probado en vivo (sin SUSE a mano). rpm es el backend real
      # de zypper, asi que se reusa el mismo formato que dnf/yum.
      salida="$(ejecutar_comando 30 rpm -qa --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\n' 2>/dev/null)"
      ;;
    apk)
      # Alpine. Tampoco probado en vivo.
      salida="$(ejecutar_comando 30 apk info -v 2>/dev/null | sed -E 's/^(.*)-([0-9][^-]*)$/\1\t\2/')"
      ;;
    pacman)
      salida="$(ejecutar_comando 30 pacman -Q 2>/dev/null | awk '{print $1 "\t" $2}')"
      ;;
    *)
      salida=""
      ;;
  esac

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Paquetes Instalados" \
      "Paquetes instalados via el gestor de paquetes del sistema ($gestor), con su version." \
      "No se pudo consultar el listado de paquetes con '$gestor' en este equipo."
    return 0
  fi

  {
    printf 'Paquete\tVersion\n'
    printf '%s\n' "$salida"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Paquetes Instalados" \
    "Paquetes instalados via el gestor de paquetes del sistema ($gestor), con su version. Equivalente Linux de la seccion Aplicaciones Instaladas de la version Windows." \
    "$archivo"
}

recolectar_firewall() {
  local id="1.14" archivo="$TMPDIR_TRABAJO/sec_1_14.tsv"

  # Leer las REGLAS de ufw/nft/iptables requiere privilegios de root en la
  # gran mayoria de distros (se confirmo asi en los dos equipos de prueba
  # de esta sesion, ninguno de los dos root). Sin root, lo unico que se
  # puede determinar con certeza es si el SERVICIO systemd correspondiente
  # esta activo, que es una simple consulta a systemd sin privilegios.
  local implementacion="${CAPS[firewall]:-}"
  local estado_servicio="N/D"

  if [ "${CAPS[init]:-otro}" = "systemd" ]; then
    estado_servicio="$(ejecutar_comando 5 systemctl is-active firewalld 2>/dev/null)"
    [ -n "$estado_servicio" ] || estado_servicio="N/D"
  fi

  local reglas=""
  if [ "${CAPS[es_root]:-0}" = "1" ]; then
    if command -v ufw >/dev/null 2>&1; then
      reglas="$(ejecutar_comando 10 ufw status verbose 2>/dev/null)"
    elif command -v nft >/dev/null 2>&1; then
      reglas="$(ejecutar_comando 10 nft list ruleset 2>/dev/null | head -50)"
    elif command -v iptables >/dev/null 2>&1; then
      reglas="$(ejecutar_comando 10 iptables -L -n 2>/dev/null | head -50)"
    fi
  fi

  {
    printf 'Campo\tValor\n'
    printf 'ImplementacionDetectada\t%s\n' "$(tsv_escape "${implementacion:-N/D}")"
    printf 'ServicioFirewalldActivo\t%s\n' "$(tsv_escape "$estado_servicio")"
    if [ -n "$reglas" ]; then
      printf '%s\n' "$reglas" | while IFS= read -r linea; do
        [ -n "$linea" ] || continue
        printf 'Regla\t%s\n' "$(tsv_escape "$linea")"
      done
    else
      printf 'Reglas\t%s\n' "(no se pudieron leer sin privilegios de root)"
    fi
  } > "$archivo"

  agregar_seccion_tabla "$id" "Firewall" \
    "Implementacion de firewall detectada (firewalld/ufw/nftables/iptables) y sus reglas si el equipo corrio como root. Sin privilegios de root, solo se puede determinar si el servicio esta activo, no el contenido de las reglas." \
    "$archivo"
}


