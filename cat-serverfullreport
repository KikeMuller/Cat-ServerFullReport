recolectar_suid_sgid() {
  local id="1.8.5" archivo="$TMPDIR_TRABAJO/sec_1_8_5.tsv"

  # Limitado a las rutas binarias estandar con -maxdepth 1: un find -perm
  # recursivo desde / puede tardar minutos en un disco grande. Es el mismo
  # tipo de recorte que la version Windows aplica a -IncludeMissingUpdates
  # (documentado, no oculto) en vez de un timeout que corte a mitad de
  # camino y devuelva una lista incompleta sin avisar.
  local salida
  salida="$(ejecutar_comando 15 find /usr/bin /usr/sbin /bin /sbin -maxdepth 1 -type f -perm -4000 2>/dev/null)"

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Binarios con SUID" \
      "Ejecutables con el bit SUID activo en las rutas binarias estandar (/usr/bin, /usr/sbin, /bin, /sbin): corren con los privilegios del dueno del archivo, no de quien los ejecuta." \
      "No se encontraron binarios con SUID en las rutas relevadas, o no se pudo determinar."
    return 0
  fi

  {
    printf 'Ruta\tPropietario\n'
    printf '%s\n' "$salida" | while IFS= read -r ruta; do
      [ -n "$ruta" ] || continue
      local dueno
      dueno="$(ejecutar_comando 5 stat -c '%U' "$ruta" 2>/dev/null)"
      [ -n "$dueno" ] || dueno="N/D"
      printf '%s\t%s\n' "$(tsv_escape "$ruta")" "$(tsv_escape "$dueno")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Binarios con SUID" \
    "Ejecutables con el bit SUID activo en /usr/bin, /usr/sbin, /bin y /sbin: corren con los privilegios del propietario del archivo (root en la mayoria de estos), no de quien los ejecuta. Una lista mas larga de lo normal aca merece revision manual." \
    "$archivo"
}

recolectar_capabilities() {
  local id="1.8.6" archivo="$TMPDIR_TRABAJO/sec_1_8_6.tsv"

  if ! ejecutar_comando 5 which getcap >/dev/null 2>&1; then
    agregar_seccion_mensaje "$id" "Capabilities de Linux Asignadas" \
      "Ejecutables con capabilities de Linux asignadas (privilegios especificos delegados a un binario, sin darle todos los permisos de root)." \
      "getcap no esta instalado en este equipo (paquete libcap2-bin en Debian/Ubuntu, libcap en RHEL)."
    return 0
  fi

  local salida
  salida="$(ejecutar_comando 15 getcap -r /usr/bin /usr/sbin /bin /sbin 2>/dev/null)"

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Capabilities de Linux Asignadas" \
