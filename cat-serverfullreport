recolectar_repos_git() {
  local id="1.19.4" archivo="$TMPDIR_TRABAJO/sec_1_19_4.tsv"

  # Opt-in via --scan-git-repos, mismo criterio que -ScanGitRepos en la
  # version Windows: recorrer /home y /root puede tardar en un servidor con
  # muchos usuarios o con home montado por red, y no todos los inventarios
  # necesitan este dato.
  if [ "${SCAN_GIT_REPOS:-0}" != "1" ]; then
    agregar_seccion_mensaje "$id" "Repositorios Git Detectados" \
      "Repositorios Git en /home y /root, con la rama activa y el remoto configurado (credenciales embebidas en la URL, si las hay, se enmascaran)." \
      "Seccion omitida por rendimiento: recorrer /home y /root puede tardar en equipos con muchos usuarios o con home montado por red. Para incluirla, volver a ejecutar el script agregando --scan-git-repos."
    return 0
  fi

  local salida
  salida="$(ejecutar_comando 15 find /home /root -maxdepth 4 -iname '.git' -type d 2>/dev/null)"

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Repositorios Git Detectados" \
      "Repositorios Git en /home y /root, con la rama activa y el remoto configurado (credenciales embebidas en la URL, si las hay, se enmascaran)." \
      "No se encontraron repositorios Git en las rutas relevadas."
    return 0
  fi

  {
    printf 'Ruta\tRamaActual\tRemoto\n'
    printf '%s\n' "$salida" | while IFS= read -r gitdir; do
      [ -n "$gitdir" ] || continue
      local repo rama remoto
      repo="$(dirname "$gitdir")"
      rama="$(ejecutar_comando 5 git -C "$repo" branch --show-current 2>/dev/null)"
      remoto="$(ejecutar_comando 5 git -C "$repo" remote get-url origin 2>/dev/null)"
      [ -n "$rama" ] || rama="N/D"
      # Enmascarar credenciales embebidas en la URL (https://user:pass@host/...).
      remoto="$(printf '%s' "$remoto" | sed -E 's#(https?://)[^/@]+:[^/@]+@#\1***:***@#')"
      [ -n "$remoto" ] || remoto="(sin remoto)"
      printf '%s\t%s\t%s\n' "$(tsv_escape "$repo")" "$(tsv_escape "$rama")" "$(tsv_escape "$remoto")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Repositorios Git Detectados" \
    "Repositorios Git en /home y /root, con la rama activa y el remoto 'origin' (credenciales embebidas en la URL enmascaradas)." \
    "$archivo"
}

