  cat <<'AYUDA_EOF'
cat-serverfullreport (borrador de prueba de concepto) - v0.1.0-slice

Uso:
  cat-serverfullreport [-o DIR] [-q] [--redact] [--format LISTA]
                       [--sections LISTA] [--skip-sections LISTA]
                       [--event-log-days N] [--scan-git-repos]
                       [--include-missing-updates]

Opciones:
  -o, --output DIR           Carpeta donde escribir el reporte (default: directorio actual)
  -q, --quiet                Silencia los mensajes de progreso. Sigue imprimiendo la ruta
                              de cada archivo generado en stdout, para poder capturarla:
                              ruta="$(cat-serverfullreport -q -o /tmp)"
  --format LISTA             Formatos de reporte a generar, separados por comas:
                              HTML, JSON, MD (o MARKDOWN, sinonimo de MD). Sin
                              distincion de mayusculas/minusculas. Default: HTML.
                              Ejemplo: --format HTML,JSON,MD
  --include-missing-updates  Consulta actualizaciones pendientes. Con root, refresca el
                              cache de paquetes primero (requiere red); sin root, lista
                              contra el cache existente, que puede estar desactualizado.
                              Desactivado por defecto porque puede ser lento.
  --redact                   Version compartible: enmascara direcciones IP, cuentas,
                              rutas de directorios personales y numeros de serie. Las
                              rutas de sistema (/etc, /usr) y las direcciones comodin
                              (0.0.0.0, 127.0.0.1) NO se enmascaran: no identifican
                              nada y son el contenido mismo de la auditoria. Aplica
                              por igual a los tres formatos de salida.
  --sections LISTA           Solo estas secciones, por prefijo de id, separadas por
                              comas. Ejemplo: --sections 1.8,1.14
  --skip-sections LISTA      Omite estas secciones. Ejemplo: --skip-sections 1.6,1.19
  --event-log-days N         Dias hacia atras para los errores del journal (default: 7)
  --scan-git-repos           Busca repositorios Git en /home y /root. Desactivado por
                              defecto porque puede tardar con muchos usuarios o con
                              home montado por red.
  -h, --help                 Esta ayuda

Corre exclusivamente local (se copia al equipo y se ejecuta ahi). Recomendado
correr como root/sudo: sin privilegios, varias secciones de seguridad quedan
incompletas (configuracion efectiva de SSH, reglas de firewall, auditoria,
numero de serie del hardware, crontabs de otros usuarios, perfiles de
AppArmor, proceso dueno de cada puerto en escucha). El script degrada con
gracia sin root -- nunca se rompe -- pero la auditoria queda menos completa.
AYUDA_EOF
}

# Se guarda ANTES de que el bucle de abajo empiece a consumir "$@" con
# shift -- despues de terminado el bucle, $# es 0 y ya no hay nada que
# guardar. Va al campo ParametrosUsados del exportador JSON.
PARAMETROS_USADOS="$*"

while [ $# -gt 0 ]; do
  case "$1" in
    # Validacion explicita en vez de "${2:?mensaje}": esa forma emite el
    # mensaje de bash crudo ("script: line 1771: 2: falta el valor..."), que
    # filtra la ruta del script, el numero de linea y el "2" del parametro
    # posicional. Un mensaje de error es texto visible al usuario y va en el
    # mismo registro que el resto de la herramienta.
    -o|--output)
      if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "Falta indicar la carpeta de salida despues de $1." >&2
        mostrar_ayuda >&2
        exit 1
      fi
      OUTPUT_PATH="$2"; shift 2 ;;
    -q|--quiet) QUIET=1; shift ;;
    --include-missing-updates) INCLUDE_MISSING_UPDATES=1; shift ;;
    # --sections / --skip-sections aceptan una lista separada por comas de
    # PREFIJOS de id ("1.8" incluye 1.8.1, 1.8.2, ...). La logica de filtrado
    # ya vive en seccion_habilitada(), invocada desde agregar_seccion_*; aca
    # solo se llenan los arreglos que esa funcion consulta.
    --sections)
      if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "Falta la lista de secciones despues de $1 (ejemplo: --sections 1.8,1.14)." >&2
        exit 1
      fi
      IFS=',' read -r -a SECTIONS_FILTER <<< "$2"; shift 2 ;;
    --skip-sections)
      if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "Falta la lista de secciones despues de $1 (ejemplo: --skip-sections 1.6,1.19)." >&2
        exit 1
      fi
      IFS=',' read -r -a SKIP_SECTIONS_FILTER <<< "$2"; shift 2 ;;
    --event-log-days)
      case "${2:-}" in
        ''|*[!0-9]*)
          echo "El valor de $1 debe ser un numero entero de dias (ejemplo: --event-log-days 14)." >&2
          exit 1 ;;
      esac
      EVENT_LOG_DAYS="$2"; shift 2 ;;
    --scan-git-repos) SCAN_GIT_REPOS=1; shift ;;
    --redact) REDACT=1; shift ;;
    # Lista separada por comas de formatos de salida, sin distinguir
    # mayusculas/minusculas. MARKDOWN es sinonimo de MD. Se valida ACA, no en
    # main(), para fallar rapido con un mensaje claro antes de correr media
    # hora de colectores.
    --format)
      if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "Falta la lista de formatos despues de $1 (ejemplo: --format HTML,JSON,MD)." >&2
        exit 1
      fi
      FORMATOS=()
      IFS=',' read -r -a _formato_lista <<< "$2"
      for _formato_item in "${_formato_lista[@]}"; do
        _formato_norm="${_formato_item^^}"
        _formato_norm="${_formato_norm# }"
        _formato_norm="${_formato_norm% }"
        [ "$_formato_norm" = "MARKDOWN" ] && _formato_norm="MD"
        case "$_formato_norm" in
          HTML|JSON|MD) FORMATOS+=("$_formato_norm") ;;
          *)
            echo "Formato desconocido: '$_formato_item'. Los formatos validos son HTML, JSON y MD (o MARKDOWN, sinonimo de MD)." >&2
            exit 1 ;;
        esac
      done
      shift 2 ;;
    -h|--help) mostrar_ayuda; exit 0 ;;
    *) echo "Argumento desconocido: $1" >&2; mostrar_ayuda >&2; exit 1 ;;
  esac
done

