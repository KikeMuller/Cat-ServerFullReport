  {
    printf 'Ruta\tCapabilities\n'
    printf '%s\n' "$salida" | awk '{ ruta=$1; cap=""; for(i=2;i<=NF;i++){cap=cap (i>2?" ":"") $i}; print ruta "\t" cap }'
