  } > "$archivo"

  agregar_seccion_tabla "$id" "Politica de Auditoria (auditd)" \
    "Estado del subsistema de auditoria del kernel (auditd): si el servicio esta activo y cuantas reglas tiene cargadas. El contenido de las reglas requiere privilegios de root para leerse." \
