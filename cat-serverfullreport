recolectar_top_procesos() {
  local id="1.17.3" archivo="$TMPDIR_TRABAJO/sec_1_17_3.tsv"

  # OJO: "cmd | head -N" como ULTIMO eslabon de un pipeline, con
  # "set -o pipefail" activo (esta activo en todo el script), revienta con
  # codigo 141 (SIGPIPE) en cuanto "ps" produce mas lineas de las que head
  # necesita: head cierra su entrada al llegar a N lineas, "ps"/"tail"
  # reciben SIGPIPE al seguir escribiendo, y pipefail toma ESE codigo como
  # el del pipeline completo -- aunque el contenido capturado en la
  # variable sea perfectamente correcto. Se detecto corriendo el bloque
  # completo (con ~50 procesos reales, mas que los 15 que pide head), no
  # con datos de prueba truncados. Fix: capturar TODA la salida de
  # ejecutar_comando primero (sin head en el mismo pipeline que se evalua),
  # y recortar a 15 lineas en un paso aparte cuyo codigo de salida no
  # importa.
  local crudo salida
  crudo="$(ejecutar_comando 10 ps aux --sort=-%mem 2>/dev/null)"
  if [ -z "$crudo" ]; then
    agregar_seccion_mensaje "$id" "Top 15 Procesos por Memoria" \
      "Los 15 procesos que mas memoria residente estan usando en este momento." \
      "No se pudo consultar la lista de procesos en este equipo."
    return 0
  fi
  salida="$(printf '%s\n' "$crudo" | tail -n +2 | head -15)"

  {
    printf 'Usuario\tPID\tCPUPct\tMemPct\tComando\n'
    printf '%s\n' "$salida" | awk '{
      usuario=$1; pid=$2; cpu=$3; mem=$4
      cmd=""
      for (i = 11; i <= NF; i++) { cmd = cmd (i > 11 ? " " : "") $i }
      print usuario "\t" pid "\t" cpu "\t" mem "\t" cmd
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Top 15 Procesos por Memoria" \
    "Los 15 procesos que mas memoria residente (%MEM) estan usando en el momento de la recoleccion. Una foto instantanea, no un promedio en el tiempo." \
    "$archivo"
}

recolectar_smart_discos() {
  local id="1.17.4" archivo="$TMPDIR_TRABAJO/sec_1_17_4.tsv"

  if ! ejecutar_comando 5 which smartctl >/dev/null 2>&1; then
    agregar_seccion_mensaje "$id" "Salud SMART de Discos Fisicos" \
      "Estado de salud SMART reportado por cada disco fisico." \
      "smartctl no esta instalado en este equipo (paquete smartmontools)."
