      "auditd no esta instalado en este equipo."
    return 0
  fi

  local activo
  activo="N/D"
  if [ "${CAPS[init]:-otro}" = "systemd" ]; then
    activo="$(ejecutar_comando 5 systemctl is-active auditd 2>/dev/null)"
    [ -n "$activo" ] || activo="N/D"
  fi

  local reglas=""
  if [ "${CAPS[es_root]:-0}" = "1" ]; then
    reglas="$(ejecutar_comando 10 auditctl -l 2>/dev/null)"
  fi

  {
    printf 'Campo\tValor\n'
    printf 'ServicioActivo\t%s\n' "$(tsv_escape "$activo")"
    if [ -n "$reglas" ]; then
