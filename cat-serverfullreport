  esac
  case " ${FORMATOS[*]} " in
    *" MD "*)
      medir_seccion "Generacion de Markdown" exportar_markdown "$archivo_md"
      _generados+=("$archivo_md") ;;
  esac

  escribir_log "Success" "Reporte generado en $OUTPUT_PATH (${#_generados[@]} archivo(s): ${FORMATOS[*]})"
  # Estas rutas se imprimen SIEMPRE, tambien con -q, a proposito: es la unica
