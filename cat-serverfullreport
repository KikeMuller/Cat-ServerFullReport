  {
    printf 'Disco\tEstadoSMART\n'
    printf '%s\n' "$discos" | while IFS= read -r d; do
      [ -n "$d" ] || continue
      local estado
      estado="$(ejecutar_comando 10 smartctl -H "/dev/$d" 2>/dev/null | awk -F': ' '/overall-health/{print $2}')"
      [ -n "$estado" ] || estado="(requiere privilegios de root, o no soportado por este disco)"
      printf '%s\t%s\n' "$(tsv_escape "/dev/$d")" "$(tsv_escape "$estado")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Salud SMART de Discos Fisicos" \
    "Estado de salud SMART reportado por cada disco fisico. Consultar smartctl generalmente requiere privilegios de root; sin ellos, la columna queda con una nota en vez de un estado." \
    "$archivo"
}

recolectar_apagados_inesperados() {
  local id="1.17.5" archivo="$TMPDIR_TRABAJO/sec_1_17_5.tsv"

  if ! ejecutar_comando 5 which last >/dev/null 2>&1; then
    agregar_seccion_mensaje "$id" "Apagados Inesperados y Reinicios" \
      "Historial de arranques y apagados de los ultimos registros de /var/log/wtmp." \
      "El comando 'last' no esta disponible en este equipo."
    return 0
  fi

  local salida
  salida="$(ejecutar_comando 10 last -x 2>/dev/null | grep -E '^(shutdown|reboot)' | head -20)"

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Apagados Inesperados y Reinicios" \
      "Historial de arranques y apagados de los ultimos registros de /var/log/wtmp." \
      "Sin registros de arranque/apagado disponibles (wtmp vacio, rotado, o sin permisos de lectura)."
    return 0
  fi

  {
    printf 'Detalle\n'
    printf '%s\n' "$salida" | while IFS= read -r linea; do
      [ -n "$linea" ] || continue
      printf '%s\n' "$(tsv_escape "$linea")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Apagados Inesperados y Reinicios" \
    "Hasta 20 eventos de arranque y apagado mas recientes de /var/log/wtmp. Un patron de 'system down' sin un 'shutdown' correspondiente reciente suele indicar un apagado no controlado (corte de energia, kernel panic)." \
    "$archivo"
}

