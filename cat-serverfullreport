  fecha="$(date '+%Y-%m-%d %H:%M')"
  if [ "$puntaje" -ge 85 ]; then pclase="badge-ok"
  elif [ "$puntaje" -ge 60 ]; then pclase="badge-warn"
  else pclase="badge-crit"
  fi

  printf '<div class="topbar" id="topbar"><div class="topbar-id"><span class="topbar-host">%s</span><span class="topbar-date">%s</span><span class="badge %s topbar-score">Salud: %s/100</span></div>' \
    "$(html_escapar "$hostname")" "$(html_escapar "$fecha")" "$pclase" "$puntaje"
  printf '<div class="topbar-actions"><div class="search-wrap"><input type="text" id="global-search" class="global-search-input" placeholder="Buscar en el reporte..." aria-label="Busqueda global"><div id="search-panel" class="search-panel" hidden></div></div>'
  printf '<button type="button" id="theme-toggle" class="icon-btn" aria-label="Cambiar tema" title="Cambiar tema">&#9788;</button>'
  printf '<button type="button" id="print-btn" class="icon-btn" aria-label="Imprimir reporte" title="Imprimir">&#128438;</button></div></div>'
  printf '<div class="print-header"><span>%s</span><span>%s</span></div>' "$(html_escapar "$hostname")" "$(html_escapar "$fecha")"
}

construir_hero() {
  local puntaje="$1" c_crit="$2" c_warn="$3" hostname="$4"
  local subtitulo=""

  if [ "${CAPS[os_nombre]:-desconocido}" != "desconocido" ]; then
    subtitulo="$(html_escapar "${CAPS[os_nombre]:-desconocido}")"
  fi
  if [ "${CAPS[kernel]:-desconocido}" != "desconocido" ]; then
    [ -n "$subtitulo" ] && subtitulo="$subtitulo &middot; "
    subtitulo="${subtitulo}$(html_escapar "Kernel ${CAPS[kernel]:-desconocido}")"
  fi
  if [ "${CAPS[en_contenedor]:-0}" = "1" ]; then
    [ -n "$subtitulo" ] && subtitulo="$subtitulo &middot; "
    subtitulo="${subtitulo}Contenedor"
  elif [ -n "${CAPS[virt]:-}" ] && [ "${CAPS[virt]}" != "desconocido" ] && [ "${CAPS[virt]}" != "none" ]; then
    [ -n "$subtitulo" ] && subtitulo="$subtitulo &middot; "
    subtitulo="${subtitulo}$(html_escapar "Maquina Virtual (${CAPS[virt]})")"
  else
    [ -n "$subtitulo" ] && subtitulo="$subtitulo &middot; "
    subtitulo="${subtitulo}Equipo Fisico"
  fi

  printf '<header class="hero"><h1>Reporte de Configuraci&oacute;n &mdash; %s</h1>' "$(html_escapar "$hostname")"
  [ -n "$subtitulo" ] && printf '<p class="hero-subtitle">%s</p>' "$subtitulo"

  printf '<div class="role-chips">'
  local hubo_rol=0
  if [ "${CAPS[selinux]:-0}" = "1" ]; then printf '<span class="role-chip">SELinux</span>'; hubo_rol=1; fi
  if [ "${CAPS[apparmor]:-0}" = "1" ]; then printf '<span class="role-chip">AppArmor</span>'; hubo_rol=1; fi
  if [ "${CAPS[en_contenedor]:-0}" = "1" ]; then printf '<span class="role-chip">Contenedor</span>'; hubo_rol=1; fi
  if [ "$hubo_rol" -eq 0 ]; then
    printf '<span class="role-chip role-chip-muted">Sin roles de servidor adicionales detectados</span>'
  fi
  printf '</div>'

  local sclase
  if [ "$puntaje" -ge 85 ]; then sclase="meter-ok"
  elif [ "$puntaje" -ge 60 ]; then sclase="meter-warn"
  else sclase="meter-crit"
  fi

  printf '<div class="kpi-grid">'
  printf '<div class="kpi-card kpi-score"><div class="kpi-label">Puntaje de Salud</div><div class="kpi-value">%s<span class="kpi-unit">/100</span></div><div class="meter-track score-track"><div class="meter-fill %s" style="width:%s%%"></div></div><div class="kpi-context">Segun hallazgos de esta ejecucion</div></div>' \
    "$puntaje" "$sclase" "$puntaje"
  printf '<div class="kpi-card kpi-crit"><div class="kpi-label">Criticos</div><div class="kpi-value">%s</div><div class="kpi-context">Hallazgos severidad CRIT</div></div>' "$c_crit"
  printf '<div class="kpi-card kpi-warn"><div class="kpi-label">Advertencias</div><div class="kpi-value">%s</div><div class="kpi-context">Hallazgos severidad WARN</div></div>' "$c_warn"

  # --- Tarjetas KPI adicionales: Uptime, RAM, Disco Mas Ocupado, Parches --
  # Se leen de las secciones YA recolectadas (1.1, 1.3, 1.16, 1.2.3) en vez
  # de recalcularlas: evita duplicar logica de coleccion en el renderer.
  # Mirror de las mismas 4 tarjetas de Build-Hero en la version Windows,
  # que faltaban aca -- el usuario las noto ausentes comparando ambos
  # reportes ("no veo los detalles del hardware"): los datos SI estaban en
  # la seccion 1.16 mas abajo en el documento, pero no en el hero, que es
  # donde un sysadmin mira primero.

  local uptime_txt="N/D"
  local archivo_1_1="${SEC_DATAFILE[1.1]:-}"
  if [ -n "$archivo_1_1" ] && [ -s "$archivo_1_1" ]; then
    uptime_txt="$(awk -F'\t' 'NR==2{print $5}' "$archivo_1_1")"
    [ -n "$uptime_txt" ] || uptime_txt="N/D"
  fi
  printf '<div class="kpi-card"><div class="kpi-label">Uptime</div><div class="kpi-value">%s</div><div class="kpi-context">Desde el ultimo arranque</div></div>' \
    "$(html_escapar "$uptime_txt")"

  local ram_gb=""
  local archivo_1_16="${SEC_DATAFILE[1.16]:-}"
  if [ -n "$archivo_1_16" ] && [ -s "$archivo_1_16" ]; then
    ram_gb="$(awk -F'\t' 'NR==2{print $9}' "$archivo_1_16")"
  fi
  if [ -n "$ram_gb" ] && [ "$ram_gb" != "N/D" ]; then
    printf '<div class="kpi-card"><div class="kpi-label">RAM Total</div><div class="kpi-value">%s<span class="kpi-unit"> GB</span></div><div class="kpi-context">Memoria fisica instalada</div></div>' "$(html_escapar "$ram_gb")"
  else
    printf '<div class="kpi-card"><div class="kpi-label">RAM Total</div><div class="kpi-value">N/D</div><div class="kpi-context">Dato no disponible</div></div>'
  fi

  # Disco mas ocupado: EXCLUYE montajes de solo lectura (mismo criterio que
  # la regla de hallazgos de storage: un punto de montaje read-only al
  # 100% -- snap, por ejemplo -- no es un problema de espacio real, asi que
  # tampoco corresponde mostrarlo como "el mas ocupado" en el hero).
  local disco_pct="" disco_punto=""
  local archivo_1_3="${SEC_DATAFILE[1.3]:-}"
  if [ -n "$archivo_1_3" ] && [ -s "$archivo_1_3" ]; then
    local linea_num=0 punto fs total_kb usado_kb libre_kb pct
    while IFS=$'\t' read -r punto fs total_kb usado_kb libre_kb pct; do
      linea_num=$((linea_num + 1))
      [ "$linea_num" -eq 1 ] && continue
      [ -z "${pct:-}" ] && continue
      local pct_num="${pct%\%}"
      case "$pct_num" in
        ''|*[!0-9]*) continue ;;
      esac
      if [ "${CAPS[findmnt]:-0}" = "1" ]; then
        local opciones_montaje
        opciones_montaje="$(ejecutar_comando 5 findmnt -no OPTIONS "$punto" 2>/dev/null)"
        case "$opciones_montaje" in
          ro|ro,*) continue ;;
        esac
      fi
      if [ -z "$disco_pct" ] || [ "$pct_num" -gt "$disco_pct" ]; then
        disco_pct="$pct_num"
        disco_punto="$punto"
      fi
    done < "$archivo_1_3"
  fi
  if [ -n "$disco_pct" ]; then
    local d_clase
    if [ "$disco_pct" -ge 90 ]; then d_clase="meter-crit"
    elif [ "$disco_pct" -ge 75 ]; then d_clase="meter-warn"
    else d_clase="meter-ok"
    fi
    local barra_disco
    barra_disco="<div class=\"meter-track\"><div class=\"meter-fill $d_clase\" style=\"width:${disco_pct}%\"></div></div>"
    printf '<div class="kpi-card"><div class="kpi-label">Disco Mas Ocupado</div><div class="kpi-value">%s<span class="kpi-unit">%%</span></div>%s<div class="kpi-context">Punto de montaje %s</div></div>' \
      "$disco_pct" "$barra_disco" "$(html_escapar "$disco_punto")"
  else
    printf '<div class="kpi-card"><div class="kpi-label">Disco Mas Ocupado</div><div class="kpi-value">N/D</div><div class="kpi-context">Dato no disponible</div></div>'
  fi

  # Parches pendientes: la seccion 1.2.3 solo tiene SEC_DATAFILE seteado si
  # --include-missing-updates estaba activo Y encontro paquetes (usa
  # agregar_seccion_tabla). Si el flag estaba apagado, o si SI se consulto
  # pero no habia nada pendiente, la seccion usa agregar_seccion_mensaje
  # (SEC_DATAFILE queda vacio en ambos casos) -- se distinguen por el texto
  # del mensaje, ya que ambos casos existen en la misma funcion y se
  # mantienen sincronizados a proposito.
  local parches="N/D" parches_ctx="No relevado en esta ejecucion (requiere --include-missing-updates)"
  local archivo_1_2_3="${SEC_DATAFILE[1.2.3]:-}"
  if [ -n "$archivo_1_2_3" ] && [ -s "$archivo_1_2_3" ]; then
    parches=$(( $(wc -l < "$archivo_1_2_3") - 1 ))
    [ "$parches" -lt 0 ] && parches=0
    parches_ctx="Actualizaciones sin aplicar"
  elif [ "${SEC_MSG[1.2.3]:-}" = "Sin actualizaciones pendientes en el momento de la consulta (o no se pudo determinar)." ]; then
    parches=0
    parches_ctx="Actualizaciones sin aplicar"
  fi
  printf '<div class="kpi-card"><div class="kpi-label">Parches Pendientes</div><div class="kpi-value">%s</div><div class="kpi-context">%s</div></div>' \
    "$(html_escapar "$parches")" "$(html_escapar "$parches_ctx")"

  printf '</div></header>'
}

construir_resumen_hallazgos() {
  local total c_crit c_warn c_info c_ok
  total=0
  [ -s "$FINDINGS_TSV" ] && total=$(wc -l < "$FINDINGS_TSV")
  c_crit=$(awk -F'\t' '$1=="CRIT"' "$FINDINGS_TSV" 2>/dev/null | wc -l)
  c_warn=$(awk -F'\t' '$1=="WARN"' "$FINDINGS_TSV" 2>/dev/null | wc -l)
  c_info=$(awk -F'\t' '$1=="INFO"' "$FINDINGS_TSV" 2>/dev/null | wc -l)
  c_ok=$(awk -F'\t' '$1=="OK"' "$FINDINGS_TSV" 2>/dev/null | wc -l)

  printf '<section class="card findings-card" id="sec-resumen-hallazgos"><h2>Resumen Ejecutivo de Hallazgos</h2>'

  if [ "$total" -eq 0 ] || { [ "$c_crit" -eq 0 ] && [ "$c_warn" -eq 0 ]; }; then
    printf '<div class="empty-state empty-state-positive"><span class="empty-icon" aria-hidden="true">&#10003;</span><p><strong>Sin hallazgos criticos ni advertencias.</strong> La configuracion relevada no presenta desvios de severidad alta o media en esta ejecucion.</p></div>'
  fi

  printf '<div class="findings-filterbar" role="group" aria-label="Filtrar hallazgos por severidad">'
  printf '<button type="button" class="chip-filter active" data-sev="ALL" aria-pressed="true">Todos <span class="chip-count">%d</span></button>' "$total"
  printf '<button type="button" class="chip-filter sev-crit" data-sev="CRIT" aria-pressed="false">Criticos <span class="chip-count">%d</span></button>' "$c_crit"
  printf '<button type="button" class="chip-filter sev-warn" data-sev="WARN" aria-pressed="false">Advertencias <span class="chip-count">%d</span></button>' "$c_warn"
  printf '<button type="button" class="chip-filter sev-info" data-sev="INFO" aria-pressed="false">Informativos <span class="chip-count">%d</span></button>' "$c_info"
  printf '<button type="button" class="chip-filter sev-ok" data-sev="OK" aria-pressed="false">Correcto <span class="chip-count">%d</span></button>' "$c_ok"
  printf '</div>'

  if [ "$total" -gt 0 ]; then
    printf '<div class="table-wrap"><table class="data-table findings-table" id="tbl-hallazgos"><thead><tr><th data-col="0" data-type="text" aria-sort="none">Severidad</th><th data-col="1" data-type="text" aria-sort="none">Categoria</th><th data-col="2" data-type="text" aria-sort="none">Hallazgo</th><th data-col="3" data-type="text" aria-sort="none">Detalle</th><th data-col="4" data-type="text" aria-sort="none">Recomendacion</th><th data-col="5" data-type="text" aria-sort="none">Control</th><th data-col="6" data-type="text" aria-sort="none">&nbsp;</th></tr></thead><tbody>'

    awk -F'\t' 'BEGIN{OFS="\t"; r["CRIT"]=0; r["WARN"]=1; r["INFO"]=2; r["OK"]=3} { rk = ($1 in r) ? r[$1] : 9; print rk, $0 }' "$FINDINGS_TSV" \
      | sort -t "$(printf '\t')" -k1,1n -k3,3 \
      | cut -f2- \
      | while IFS= read -r _linea_h; do
          # dividir_tsv en vez de "read -r sev cat item det rec ctrl secref":
          # casi todos los hallazgos dejan vacio el detalle o el control, y
          # con read esos campos se colapsaban, corriendo las columnas y
          # dejando sin enlace "Ver" a los hallazgos afectados.
          dividir_tsv "$_linea_h"
          local sev="${CAMPOS[0]:-}" cat="${CAMPOS[1]:-}" item="${CAMPOS[2]:-}"
          local det="${CAMPOS[3]:-}" rec="${CAMPOS[4]:-}" ctrl="${CAMPOS[5]:-}"
          local secref="${CAMPOS[6]:-}"
          if [ "${REDACT:-0}" = "1" ]; then
            # El detalle es donde los hallazgos citan evidencia concreta
            # ("Puerto 23 abierto en 10.1.2.3"), asi que es exactamente lo
            # que hay que tapar en un reporte compartible. El titulo y la
            # recomendacion no se tocan: son texto generico y enmascararlos
            # dejaria la lista de hallazgos ilegible.
            enmascarar_texto_libre "$det"; det="$VALOR_ENMASCARADO"
          fi
          local sevclase="badge-neutral"
          case "$sev" in
            CRIT) sevclase="badge-crit" ;;
            WARN) sevclase="badge-warn" ;;
            INFO) sevclase="badge-info" ;;
            OK) sevclase="badge-ok" ;;
          esac
          local verlink='<span class="dim">&mdash;</span>'
          if [ -n "$secref" ]; then
            local anchor="sec-${secref//[^A-Za-z0-9]/-}"
            verlink="<a href=\"#${anchor}\" class=\"ver-link\">Ver &rarr;</a>"
          fi
          printf '<tr data-sev="%s"><td><span class="badge %s">%s</span></td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>' \
            "$(html_escapar "$sev")" "$sevclase" "$(html_escapar "$sev")" "$(html_escapar "$cat")" \
            "$(html_escapar "$item")" "$(html_escapar "$det")" "$(html_escapar "$rec")" "$(html_escapar "$ctrl")" "$verlink"
        done

    printf '</tbody></table></div>'
  fi

  printf '</section>'
}

construir_seccion() {
  local id="$1"
  # Misma razon que en construir_sidebar: ${var//[^A-Za-z0-9]/-} nativo en
  # vez de un fork a sed por cada seccion del reporte.
  local anchor="sec-${id//[^A-Za-z0-9]/-}"
  local titulo="${SEC_TITLE[$id]}"
  local nota="${SEC_NOTE[$id]}"

  html_escapar_var "$id";     local esc_id="$HTML_ESC"
  html_escapar_var "$titulo"; local esc_tit="$HTML_ESC"
  printf '<section class="card" id="%s"><h2>%s &mdash; %s</h2>' \
    "$anchor" "$esc_id" "$esc_tit"
  [ -n "$nota" ] && printf '<p class="section-note">%s</p>' "$(html_escapar "$nota")"

  if [ "${SEC_ISMSG[$id]}" = "1" ]; then
    bloque_mensaje "${SEC_MSG[$id]}"
  else
    local rowcount="${SEC_ROWCOUNT[$id]}"
    if [ "$rowcount" -gt 0 ]; then
      local tabla_id="tbl-${id//[^A-Za-z0-9]/-}"
      printf '<details class="subsection-details" open><summary>%s <span class="badge badge-neutral count-badge">%d filas</span></summary><div class="details-body">' \
        "$esc_tit" "$rowcount"
      tabla_html_desde_tsv "${SEC_DATAFILE[$id]}" "$tabla_id"
      printf '</div></details>'
    else
      estado_vacio "Sin datos disponibles o rol no instalado."
    fi
  fi

  printf '</section>'
}

construir_footer() {
  local hostname="$1"
  local fecha usuario
  fecha="$(date '+%Y-%m-%d %H:%M:%S')"
  # "id -un" primero y las variables de entorno solo como respaldo, por dos
  # razones, las dos verificadas:
  #  1) $USER y $LOGNAME NO estan definidas en varios de los contextos donde
  #     este script esta pensado para correr -- cron, una unidad de systemd,
  #     "sudo -n", "ssh equipo 'comando'". Ahi el pie del reporte quedaba
  #     "Generado por N/D", perdiendo metadato de auditoria que si se podia
  #     obtener.
  #  2) $USER puede MENTIR: despues de un "su otro" (sin guion) la variable
  #     conserva el usuario anterior mientras el UID efectivo ya cambio. Para
  #     un reporte de auditoria interesa quien lo genero de verdad.
  usuario="$(ejecutar_comando 5 id -un 2>/dev/null)"
  [ -n "$usuario" ] || usuario="${USER:-${LOGNAME:-N/D}}"

  printf '<footer class="report-footer"><p class="footer-meta">Generado por <strong>%s</strong> desde <strong>%s</strong> el %s &middot; Script v%s (borrador de prueba de concepto)</p>' \
    "$(html_escapar "$usuario")" "$(html_escapar "$hostname")" "$(html_escapar "$fecha")" "$(html_escapar "$SCRIPT_VERSION")"

  if [ "${#LOG_LINEAS[@]}" -gt 0 ]; then
    printf '<details class="footer-details"><summary>Log de ejecucion (%d lineas)</summary><div class="details-body"><pre class="log-block">' \
      "${#LOG_LINEAS[@]}"
    local l
    for l in "${LOG_LINEAS[@]}"; do
      printf '%s\n' "$(html_escapar "$l")"
    done
    printf '</pre></div></details>'
  fi

  printf '</footer>'
}

generar_html() {
