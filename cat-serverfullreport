_mapear_tipo_chasis() {
  # Tabla SMBIOS estandar (System Enclosure or Chassis Types). Solo los
  # codigos mas comunes; el resto se muestra con el codigo crudo en vez de
  # inventar una categoria.
  case "$1" in
    3) echo "Desktop" ;;
    4) echo "Low Profile Desktop" ;;
    6) echo "Mini Tower" ;;
    7) echo "Tower" ;;
    8) echo "Portable" ;;
    9) echo "Laptop" ;;
    10) echo "Notebook" ;;
    11) echo "Hand Held" ;;
    13) echo "All in One" ;;
    14) echo "Sub Notebook" ;;
    17) echo "Servidor (Main Server Chassis)" ;;
    23) echo "Servidor (Rack Mount Chassis)" ;;
    30) echo "Tablet" ;;
    31) echo "Convertible" ;;
    32) echo "Detachable" ;;
    *) echo "Codigo $1 (no mapeado)" ;;
  esac
}

recolectar_hardware() {
  local id="1.16" archivo="$TMPDIR_TRABAJO/sec_1_16.tsv"

  local nucleos_logicos modelo_cpu mem_kb mem_gb
  nucleos_logicos="$(ejecutar_comando 5 nproc 2>/dev/null)"
  [ -n "$nucleos_logicos" ] || nucleos_logicos="N/D"

  modelo_cpu="$(ejecutar_comando 5 grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed 's/^.*: //')"
  [ -n "$modelo_cpu" ] || modelo_cpu="N/D"

  mem_kb="$(ejecutar_comando 5 grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')"
  if [ -n "$mem_kb" ]; then
    # LC_ALL=C: este awk no pasa por ejecutar_comando (no hay comando
    # externo que envolver, es aritmetica pura sobre un valor ya leido), asi
    # que no hereda el locale forzado de ahi. Se detecto en el servidor real
    # ("15,0" en vez de "15.0") corriendo el bloque completo, no leyendo el
    # codigo -- exactamente el mismo tipo de bug que motivo el fix central
    # en ejecutar_comando, pero esta instancia queda fuera de esa cobertura
    # por no ser un comando externo.
    mem_gb="$(LC_ALL=C awk -v kb="$mem_kb" 'BEGIN{printf "%.1f", kb/1024/1024}')"
  else
    mem_gb="N/D"
  fi

  # Nucleos FISICOS (distinto de nproc, que cuenta hilos/logicos): Socket(s)
  # x Core(s) per socket, via lscpu, que no requiere privilegios.
  local nucleos_fisicos="N/D"
  local lscpu_out sockets cores_por_socket
  lscpu_out="$(ejecutar_comando 5 lscpu 2>/dev/null)"
  if [ -n "$lscpu_out" ]; then
    sockets="$(printf '%s\n' "$lscpu_out" | awk -F: '/^Socket\(s\):/{gsub(/^[ \t]+/,"",$2); print $2}')"
    cores_por_socket="$(printf '%s\n' "$lscpu_out" | awk -F: '/^Core\(s\) per socket:/{gsub(/^[ \t]+/,"",$2); print $2}')"
    # Validar CADA variable por separado, no la concatenacion: con
    # "$sockets$cores_por_socket" en un solo case, sockets="1" +
    # cores_por_socket="" (vacio) concatena a "1", que SI pasa el chequeo
    # de "es numerico" -- y el $((...)) de abajo trata la variable vacia
    # como 0, dando NucleosFisicos=0 en silencio en vez de N/D.
    case "$sockets" in
      ''|*[!0-9]*) ;;
      *)
        case "$cores_por_socket" in
          ''|*[!0-9]*) ;;
          *) nucleos_fisicos=$((sockets * cores_por_socket)) ;;
        esac
        ;;
    esac
  fi

  # Fabricante, modelo y tipo de chasis: se leen de /sys/class/dmi/id/, que
  # en la gran mayoria de los kernels modernos es legible SIN root (a
  # diferencia de dmidecode, que requiere leer /sys/firmware/dmi/tables
  # directamente). Se confirmo esto corriendo contra hardware real: en un
  # Dell Latitude sin privilegios, product_name/sys_vendor/chassis_type se
  # leyeron bien; SOLO product_serial devolvio "Permission denied". Antes
  # de este ajuste, esta seccion entera dependia de dmidecode+root y
  # quedaba en N/D en el caso mas comun (usuario sin sudo).
  local fabricante="N/D" modelo_equipo="N/D" tipo_chasis="N/D" serial="N/D"
  local v m t
  v="$(ejecutar_comando 5 cat /sys/class/dmi/id/sys_vendor 2>/dev/null)"
  m="$(ejecutar_comando 5 cat /sys/class/dmi/id/product_name 2>/dev/null)"
  t="$(ejecutar_comando 5 cat /sys/class/dmi/id/chassis_type 2>/dev/null)"
  [ -n "$v" ] && fabricante="$v"
  [ -n "$m" ] && modelo_equipo="$m"
  case "$t" in
    ''|*[!0-9]*) ;;  # vacio o no numerico: se queda en N/D
    *) tipo_chasis="$(_mapear_tipo_chasis "$t")" ;;
  esac

  # El numero de serie SI suele requerir root incluso via sysfs (proteccion
  # de privacidad del kernel). Se intenta sin privilegios primero por si el
  # kernel en cuestion lo permite, y se cae a dmidecode+root como respaldo.
  serial="$(ejecutar_comando 5 cat /sys/class/dmi/id/product_serial 2>/dev/null)"
  if [ -z "$serial" ] && [ "${CAPS[dmidecode]:-0}" = "1" ] && [ "${CAPS[es_root]:-0}" = "1" ]; then
    serial="$(ejecutar_comando 5 dmidecode -s system-serial-number 2>/dev/null)"
  fi
  [ -n "$serial" ] || serial="N/D"

  # Maquina virtual: ya detectado en CAPS (Get-TargetCapabilities remoto),
  # se expone aca tambien como columna explicita para paridad con la tabla
  # de hardware de la version Windows (que trae MaquinaVirtual como campo
  # propio, no solo mencionado en el subtitulo del reporte).
  local es_maquina_virtual="No"
  if [ "${CAPS[en_contenedor]:-0}" = "1" ]; then
    es_maquina_virtual="Si (contenedor)"
  elif [ -n "${CAPS[virt]:-}" ] && [ "${CAPS[virt]}" != "desconocido" ] && [ "${CAPS[virt]}" != "none" ]; then
    es_maquina_virtual="Si (${CAPS[virt]})"
  fi

  {
    printf 'Hostname\tFabricante\tModelo\tTipoSistema\tMaquinaVirtual\tCPU\tNucleosFisicos\tNucleosLogicos\tMemoriaTotalGB\tNumeroSerie\n'
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(tsv_escape "${CAPS[hostname]:-N/D}")" "$(tsv_escape "$fabricante")" "$(tsv_escape "$modelo_equipo")" \
      "$(tsv_escape "$tipo_chasis")" "$(tsv_escape "$es_maquina_virtual")" "$(tsv_escape "$modelo_cpu")" \
      "$(tsv_escape "$nucleos_fisicos")" "$(tsv_escape "$nucleos_logicos")" "$(tsv_escape "$mem_gb")" "$(tsv_escape "$serial")"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Hardware del Host" \
    "Fabricante, modelo, tipo de chasis, CPU (nucleos fisicos y logicos) y memoria, leidos de /proc, /sys y lscpu -- ninguno requiere privilegios de root. Excepcion: el numero de serie casi siempre esta protegido por el kernel y solo se completa si el script corrio como root con dmidecode instalado." \
    "$archivo"
}

recolectar_journal_errores() {
  local id="1.17.1" archivo="$TMPDIR_TRABAJO/sec_1_17_1.tsv"

  if [ "${CAPS[journalctl]:-0}" != "1" ]; then
    agregar_seccion_mensaje "$id" "Errores Recientes del Journal" \
      "Entradas de nivel error o superior en los ultimos ${EVENT_LOG_DAYS:-7} dias." \
      "journalctl no esta disponible en este equipo (no usa systemd-journald)."
    return 0
  fi

  local salida
  salida="$(ejecutar_comando 20 journalctl -p err --since "-${EVENT_LOG_DAYS:-7}days" --no-pager -o short-iso 2>/dev/null | tail -100)"

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Errores Recientes del Journal" \
      "Entradas de nivel error o superior en los ultimos ${EVENT_LOG_DAYS:-7} dias." \
      "Sin entradas de error en la ventana consultada."
    return 0
  fi

  {
    printf 'FechaHoraUnidad\n'
    printf '%s\n' "$salida" | while IFS= read -r linea; do
      [ -n "$linea" ] || continue
      printf '%s\n' "$(tsv_escape "$linea")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Errores Recientes del Journal" \
    "Hasta 100 entradas de nivel error o superior de los ultimos ${EVENT_LOG_DAYS:-7} dias, mas recientes primero. No se separa por unidad ni se cuenta por ID como en la version Windows (esa capa de agrupacion queda pendiente); cada fila es una linea cruda de journalctl." \
    "$archivo"
}

