  # Los mensajes de progreso, que si respetan -q, salen por escribir_log. No
  # unificar ambas cosas.
  local _ruta_generada
  for _ruta_generada in "${_generados[@]}"; do
    printf '%s\n' "$_ruta_generada"
  done
}


# =============================================================================
# REGION: COLECTORES - Bloque de Seguridad (1.7 - 1.9)
# =============================================================================
#
# Equivalente Linux de la seccion 1.11 (Seguridad y Cumplimiento) de la
# version Windows: SSH endurecido en vez de SChannel, UID 0 / sudo en vez de
# administradores locales, SELinux/AppArmor en vez de UAC/Device Guard.

recolectar_ssh() {
  local id="1.7" archivo="$TMPDIR_TRABAJO/sec_1_7.tsv"

  if [ "${CAPS[sshd]:-0}" != "1" ]; then
    agregar_seccion_mensaje "$id" "Servidor SSH (Configuracion Efectiva)" \
      "Configuracion EFECTIVA de sshd (resultado de 'sshd -T': combina sshd_config con los valores por defecto de OpenSSH), no el archivo crudo. Equivalente Linux de la seccion SChannel del proyecto Windows." \
      "sshd no esta instalado en este equipo; no hay servidor SSH que auditar."
    return 0
  fi

  local salida
  if ! salida="$(ejecutar_comando 10 sshd -T 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Servidor SSH (Configuracion Efectiva)" \
      "Configuracion efectiva de sshd." \
      "No se pudo ejecutar 'sshd -T' (en algunas distribuciones requiere privilegios de root para leer la clave del host, o el binario no soporta -T)."
    return 0
  fi

  {
    printf 'Directiva\tValor\n'
    printf '%s\n' "$salida" | awk 'NF>=2 {
      d = $1
      v = $2
      for (i = 3; i <= NF; i++) { v = v " " $i }
      print d "\t" v
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Servidor SSH (Configuracion Efectiva)" \
    "Configuracion EFECTIVA de sshd ('sshd -T': sshd_config combinado con los valores por defecto de OpenSSH). Equivalente Linux de la seccion SChannel del proyecto Windows." \
    "$archivo"
}

recolectar_cuentas_uid0() {
  local id="1.8.1" archivo="$TMPDIR_TRABAJO/sec_1_8_1.tsv"

  {
    printf 'Usuario\tUID\tGID\tShell\tDirectorioHome\n'
    awk -F: '$3 == 0 { print $1 "\t" $3 "\t" $4 "\t" $7 "\t" $6 }' /etc/passwd 2>/dev/null
  } > "$archivo"

  agregar_seccion_tabla "$id" "Cuentas con Privilegios de Root (UID 0)" \
    "Toda cuenta local con UID 0 tiene privilegios completos de root, sin importar su nombre. Deberia existir una sola: 'root'. Una segunda cuenta con UID 0 es la puerta trasera mas clasica de todas." \
    "$archivo"
}

recolectar_sudo() {
  local id="1.8.2" archivo="$TMPDIR_TRABAJO/sec_1_8_2.tsv"

  local archivos_sudoersd=""
  if [ -d /etc/sudoers.d ]; then
    archivos_sudoersd="$(find /etc/sudoers.d -maxdepth 1 -type f ! -name README 2>/dev/null \
      | xargs -n1 basename 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
  fi
  [ -n "$archivos_sudoersd" ] || archivos_sudoersd="(ninguno)"

  {
    printf 'Grupo\tMiembros\tArchivosEnSudoersD\n'
    local grupo miembros
    for grupo in sudo wheel; do
      # getent con timeout: resuelve contra nsswitch.conf completo, asi que
      # en un equipo unido a dominio (ldap/sss) con el directorio
      # inalcanzable se queda esperando el timeout de la libreria, que puede
      # ser mucho mayor que el nuestro. Es la misma razon que findmnt sobre
      # NFS caido: no dejar que una dependencia de red cuelgue el reporte.
      if ejecutar_comando 5 getent group "$grupo" >/dev/null 2>&1; then
        miembros="$(ejecutar_comando 5 getent group "$grupo" | awk -F: '{print $4}')"
        [ -n "$miembros" ] || miembros="(ninguno)"
        printf '%s\t%s\t%s\n' "$grupo" "$(tsv_escape "$miembros")" "$(tsv_escape "$archivos_sudoersd")"
      fi
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Grupos con Privilegios de Sudo" \
    "Miembros de los grupos sudo/wheel (privilegios administrativos via sudo) y archivos de reglas adicionales en /etc/sudoers.d. Solo se listan los nombres de archivo, nunca su contenido." \
    "$archivo"
}

recolectar_politica_password() {
  local id="1.8.3" archivo="$TMPDIR_TRABAJO/sec_1_8_3.tsv"

  if [ ! -r /etc/login.defs ]; then
    agregar_seccion_mensaje "$id" "Politica de Contrasenas (login.defs)" \
      "Valores por defecto de vigencia de contrasena para cuentas locales nuevas: dias maximos, minimos y de aviso antes de expirar." \
      "No se pudo leer /etc/login.defs en este equipo."
    return 0
  fi

  {
    printf 'Parametro\tValor\n'
    awk '
      /^PASS_MAX_DAYS[ \t]/ { print "PASS_MAX_DAYS\t" $2 }
      /^PASS_MIN_DAYS[ \t]/ { print "PASS_MIN_DAYS\t" $2 }
      /^PASS_WARN_AGE[ \t]/ { print "PASS_WARN_AGE\t" $2 }
      /^PASS_MIN_LEN[ \t]/  { print "PASS_MIN_LEN\t" $2 }
    ' /etc/login.defs
  } > "$archivo"

  agregar_seccion_tabla "$id" "Politica de Contrasenas (login.defs)" \
    "Valores por defecto de vigencia de contrasena para cuentas locales NUEVAS: dias maximos/minimos entre cambios y dias de aviso antes de expirar. Una cuenta ya creada puede tener sus propios valores via 'chage', que esta tabla no muestra." \
    "$archivo"
}

recolectar_mac() {
  # MAC = Mandatory Access Control (SELinux / AppArmor). Id 1.9, como en el
  # inventario planeado.
  local id="1.9" archivo="$TMPDIR_TRABAJO/sec_1_9.tsv"

  if [ "${CAPS[selinux]:-0}" = "1" ]; then
    local estado
    estado="$(ejecutar_comando 5 getenforce 2>/dev/null)"
    [ -n "$estado" ] || estado="desconocido"
    {
      printf 'Mecanismo\tEstado\tDetalle\n'
      printf 'SELinux\t%s\t%s\n' "$(tsv_escape "$estado")" "Modo operativo reportado por getenforce"
    } > "$archivo"
    agregar_seccion_tabla "$id" "Control de Acceso Obligatorio (SELinux / AppArmor)" \
      "Estado del mecanismo de control de acceso obligatorio (MAC) activo en el equipo. SELinux en modo Permissive o Disabled, o AppArmor sin perfiles en enforce, reducen el aislamiento entre procesos frente a una vulnerabilidad explotada." \
      "$archivo"
    return 0
  fi

  if [ "${CAPS[apparmor]:-0}" = "1" ]; then
    local salida
    if ! salida="$(ejecutar_comando 10 aa-status 2>/dev/null)"; then
      agregar_seccion_mensaje "$id" "Control de Acceso Obligatorio (SELinux / AppArmor)" \
        "Estado del mecanismo de control de acceso obligatorio activo en el equipo." \
        "AppArmor esta instalado pero no se pudo ejecutar 'aa-status' (usualmente requiere privilegios de root)."
      return 0
    fi

    local cargados enforce complain
    cargados="$(printf '%s\n' "$salida" | awk '/profiles are loaded/ { print $1; exit }')"
    enforce="$(printf '%s\n' "$salida" | awk '/profiles are in enforce mode/ { print $1; exit }')"
    complain="$(printf '%s\n' "$salida" | awk '/profiles are in complain mode/ { print $1; exit }')"
    [ -n "$cargados" ] || cargados="N/D"
    [ -n "$enforce" ] || enforce="N/D"
    [ -n "$complain" ] || complain="N/D"

    {
      printf 'Mecanismo\tEstado\tDetalle\n'
      printf 'AppArmor\tActivo\t%s\n' \
        "$(tsv_escape "${cargados} perfiles cargados, ${enforce} en modo enforce, ${complain} en modo complain")"
    } > "$archivo"
    agregar_seccion_tabla "$id" "Control de Acceso Obligatorio (SELinux / AppArmor)" \
      "Estado del mecanismo de control de acceso obligatorio (MAC) activo en el equipo. SELinux en modo Permissive o Disabled, o AppArmor sin perfiles en enforce, reducen el aislamiento entre procesos frente a una vulnerabilidad explotada." \
      "$archivo"
    return 0
  fi

  agregar_seccion_mensaje "$id" "Control de Acceso Obligatorio (SELinux / AppArmor)" \
    "Estado del mecanismo de control de acceso obligatorio activo en el equipo." \
    "No se detecto SELinux ni AppArmor instalado en este equipo."
}

