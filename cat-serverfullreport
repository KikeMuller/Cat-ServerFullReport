motor_regla_firewall() {
  local archivo="${SEC_DATAFILE[1.14]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local estado_firewalld impl
  estado_firewalld="$(awk -F'\t' '$1=="ServicioFirewalldActivo"{print $2}' "$archivo")"
  impl="$(awk -F'\t' '$1=="ImplementacionDetectada"{print $2}' "$archivo")"

  if [ "$estado_firewalld" = "active" ]; then
    agregar_hallazgo "OK" "Red" "Firewalld activo" "" \
      "El servicio firewalld esta activo." "CIS 3.5 / ISO 27001 A.13.1.1" "1.14"
    return 0
  fi

  if [ "$impl" = "firewalld" ]; then
    # CAPS[firewall] solo se marca "firewalld" cuando el servicio esta
    # activo (ver detectar_capacidades); si llegamos aca con impl=firewalld
    # y estado_firewalld != active es porque el estado cambio entre la
    # deteccion de capacidades y este colector -- caso raro, no se afirma
    # nada para no arriesgar un WARN sobre un estado que ya no es el actual.
    return 0
  fi

  # ufw: "ufw status [verbose]" exige root incluso solo para consultar
  # estado (confirmado corriendo con y sin privilegios contra el mismo
  # servidor). Sin root, recolectar_firewall no llega a pedirlo, asi que la
  # tabla no tiene una fila "Regla" con "Status: ..." y esta regla queda en
  # silencio -- no afirma "activo" ni "inactivo" sobre un dato que no pudo
  # leer, la misma disciplina que el resto del motor.
  if [ "$impl" = "ufw" ]; then
    local estado_ufw
    estado_ufw="$(awk -F'\t' '$1=="Regla" && $2 ~ /^Status: /{print $2; exit}' "$archivo")"
    case "$estado_ufw" in
      "Status: active")
        agregar_hallazgo "OK" "Red" "UFW activo" "" \
          "ufw esta activo." "CIS 3.5 / ISO 27001 A.13.1.1" "1.14"
        ;;
      "Status: inactive")
        agregar_hallazgo "WARN" "Red" "UFW instalado pero inactivo" "" \
          "ufw esta instalado pero no filtra trafico (Status: inactive). Activarlo con 'ufw enable' si no hay otro control de firewall equivalente (nftables/iptables) cubriendo el equipo." \
          "CIS 3.5 / ISO 27001 A.13.1.1" "1.14"
        ;;
    esac
    return 0
  fi

  # nftables/iptables: sin root no se leen reglas (ver recolectar_firewall),
  # asi que no hay forma confiable de distinguir "sin reglas" de "no se
  # pudo consultar" -- queda en silencio para ambos, misma disciplina.
  # Tampoco hay ninguna implementacion detectada (impl vacio): silencio.
}

motor_regla_journal() {
  local archivo="${SEC_DATAFILE[1.17.1]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local total
  total=$(( $(wc -l < "$archivo") - 1 ))
  [ "$total" -lt 0 ] && total=0

  if [ "$total" -ge 50 ]; then
    agregar_hallazgo "INFO" "Mantenimiento" "Volumen alto de errores en el journal" \
      "$total entradas de error en los ultimos ${EVENT_LOG_DAYS:-7} dias (se muestran hasta 100)." \
      "Revisar el journal para identificar si son errores recurrentes de un mismo servicio." \
      "" "1.17.1"
  fi
  # Pocos o cero errores: no se emite OK aca. A diferencia de otras
  # secciones, "pocos errores en el journal" no es una afirmacion de
  # cumplimiento verificable (no hay un control CIS/ISO que diga "el
  # journal debe estar limpio"), asi que no corresponde forzar un veredicto
  # binario bien/mal solo para llenar el resumen ejecutivo.
}

