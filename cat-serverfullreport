# REGION: COLECTORES - Bloque de Salud y Mantenimiento (1.10 - 1.13)
# =============================================================================

recolectar_cron() {
  local id="1.10.1" archivo="$TMPDIR_TRABAJO/sec_1_10_1.tsv"

  # "crontab -u <otro_usuario> -l" exige root ("must be privileged to use
  # -u", confirmado contra un usuario real sin privilegios). Sin root, solo
  # se puede leer la propia; con root, se recorre cada cuenta humana
  # (UID 1000-59999) mas root mismo -- acercando esta seccion a "Tareas
  # Programadas Activas" de la version Windows, que no esta limitada al
  # usuario que ejecuta el script.
  {
    printf 'Origen\tDetalle\n'

    if [ "${CAPS[es_root]:-0}" = "1" ]; then
      local usuarios
      usuarios="root
$(ejecutar_comando 5 awk -F: '$3>=1000 && $3<60000 {print $1}' /etc/passwd 2>/dev/null)"
      printf '%s\n' "$usuarios" | while IFS= read -r u; do
        [ -n "$u" ] || continue
        local ct
        ct="$(ejecutar_comando 5 crontab -u "$u" -l 2>/dev/null)"
        [ -n "$ct" ] || continue
        printf '%s\n' "$ct" | grep -v '^\s*#' | grep -v '^\s*$' | while IFS= read -r linea; do
          printf 'crontab (%s)\t%s\n' "$(tsv_escape "$u")" "$(tsv_escape "$linea")"
        done
      done
    else
      local crontab_usuario
      crontab_usuario="$(ejecutar_comando 5 crontab -l 2>/dev/null)"
      if [ -n "$crontab_usuario" ]; then
        printf '%s\n' "$crontab_usuario" | grep -v '^\s*#' | grep -v '^\s*$' | while IFS= read -r linea; do
          printf 'crontab (usuario actual)\t%s\n' "$(tsv_escape "$linea")"
        done
      fi
    fi

    if [ -d /etc/cron.d ]; then
      ejecutar_comando 5 find /etc/cron.d -maxdepth 1 -type f 2>/dev/null | while IFS= read -r archivo_cron; do
        printf '/etc/cron.d\t%s\n' "$(tsv_escape "$(basename "$archivo_cron")")"
      done
    fi
  } > "$archivo"

  agregar_seccion_tabla "$id" "Tareas Programadas (cron)" \
    "Entradas de crontab (de todos los usuarios si el script corrio como root; solo del usuario actual si no) y nombres de archivo en /etc/cron.d. Comentarios y lineas vacias omitidos." \
    "$archivo"
}

recolectar_timers() {
  local id="1.10.2" archivo="$TMPDIR_TRABAJO/sec_1_10_2.tsv"

  local salida
  if ! salida="$(ejecutar_comando 15 systemctl list-timers --all --no-legend --no-pager 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Timers de systemd" \
      "Temporizadores de systemd (equivalente moderno de cron para unidades systemd) y el servicio que disparan." \
      "No se pudo consultar 'systemctl list-timers' en este equipo."
    return 0
  fi

  {
    printf 'Timer\tServicio\n'
    # El formato de "list-timers" tiene columnas de fecha con espacios
    # internos ("Sat 2026-09-12 00:00:00 -03") y de tiempo restante variable
    # ("4h 54min" vs "19h ago"), asi que no se puede extraer con columnas
    # fijas sin arriesgar un corte a mitad de fecha. Se toman solo las
    # ULTIMAS dos columnas (timer y servicio), que son siempre un solo
    # token cada una y estan al final de la linea sin ambiguedad.
    printf '%s\n' "$salida" | awk 'NF>=2 { print $(NF-1) "\t" $NF }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Timers de systemd" \
    "Temporizadores de systemd (equivalente moderno de cron para unidades systemd gestionadas) y el servicio que disparan." \
    "$archivo"
}

recolectar_sysctl() {
  local id="1.11" archivo="$TMPDIR_TRABAJO/sec_1_11.tsv"

  local claves="net.ipv4.ip_forward net.ipv4.conf.all.rp_filter net.ipv4.icmp_echo_ignore_broadcasts kernel.randomize_va_space net.ipv4.tcp_syncookies"
  {
    printf 'Parametro\tValor\n'
    local k v
    for k in $claves; do
      v="$(ejecutar_comando 5 sysctl -n "$k" 2>/dev/null)"
      [ -n "$v" ] || v="N/D"
      printf '%s\t%s\n' "$k" "$(tsv_escape "$v")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Hardening de Kernel (sysctl)" \
    "Subconjunto de parametros de kernel relevantes para seguridad de red y proteccion de memoria. net.ipv4.ip_forward=1 NO es necesariamente un problema: es normal y esperado en cualquier equipo con Docker, una VPN o enrutamiento intencional, asi que esta tabla lo muestra pero el motor de hallazgos no opina sobre el, para no generar advertencias falsas en la mayoria de los servidores reales." \
    "$archivo"
}

recolectar_reinicio_pendiente() {
  local id="1.12" archivo="$TMPDIR_TRABAJO/sec_1_12.tsv"

  # OJO: "command -v" y "[" son builtins de bash, no binarios -- pasarlos
  # por ejecutar_comando (que envuelve con "timeout", el cual solo puede
  # invocar ejecutables reales) fallaria en silencio. "test" SI es ademas
  # un binario real (/usr/bin/test) en cualquier distro con coreutils, asi
  # que se usa directo. Para needs-restarting, en vez de verificar primero
  # si existe, se lo ejecuta directo y se interpreta el codigo de salida:
  # 127 = comando ausente, 0 = no hace falta reiniciar, 1 = si hace falta
  # (documentado asi por el propio needs-restarting -r).
  local pendiente="No" motivo=""
  if ejecutar_comando 5 test -f /var/run/reboot-required 2>/dev/null; then
    pendiente="Si"
    motivo="$(ejecutar_comando 5 cat /var/run/reboot-required 2>/dev/null)"
    [ -n "$motivo" ] || motivo="/var/run/reboot-required presente"
  else
    local codigo_nr
    ejecutar_comando 10 needs-restarting -r >/dev/null 2>&1
    codigo_nr=$?
    if [ "$codigo_nr" -eq 1 ]; then
      pendiente="Si"
      motivo="needs-restarting -r reporto reinicio pendiente"
    fi
    # codigo 127 (needs-restarting no instalado, tipico fuera de RHEL) o 0
    # (instalado y dice que no hace falta): queda en "No" por defecto.
  fi

  {
    printf 'ReinicioPendiente\tMotivo\n'
    printf '%s\t%s\n' "$pendiente" "$(tsv_escape "$motivo")"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Reinicio Pendiente" \
    "Indica si el equipo tiene una actualizacion de kernel u otro componente que requiere reinicio para aplicarse por completo. En Debian/Ubuntu se basa en /var/run/reboot-required; en RHEL/Fedora, en 'needs-restarting -r' si esta disponible (paquete dnf-utils/yum-utils)." \
    "$archivo"
}

recolectar_certificados() {
  local id="1.13" archivo="$TMPDIR_TRABAJO/sec_1_13.tsv"

  if ! ejecutar_comando 5 which openssl >/dev/null 2>&1; then
    agregar_seccion_mensaje "$id" "Certificados TLS Instalados" \
      "Certificados TLS en las rutas habituales del sistema, con fecha de expiracion." \
      "openssl no esta instalado en este equipo; no se puede leer la fecha de expiracion de los certificados."
    return 0
  fi

  # Hasta 30 certificados de las rutas mas comunes, para no demorar la
  # recoleccion en un equipo con muchisimos certificados instalados.
  # El filtro de ca-certificates.crt va ACA, antes de decidir si "hay
  # archivos" -- se probo que en un equipo donde ese bundle es el UNICO
  # match del patron *.crt, filtrarlo recien dentro del while dejaba la
  # tabla con 0 filas (que se ve identica a un estado vacio generico) en
  # vez de caer en el mensaje explicativo de abajo.
  local archivos
  archivos="$(ejecutar_comando 10 find /etc/ssl/certs /etc/pki/tls/certs /etc/letsencrypt/live \
    -maxdepth 2 -type f \( -name '*.crt' -o -name '*.pem' \) 2>/dev/null \
    | grep -v '/ca-certificates\.crt$' | head -30)"

  if [ -z "$archivos" ]; then
    agregar_seccion_mensaje "$id" "Certificados TLS Instalados" \
      "Certificados TLS en las rutas habituales del sistema, con fecha de expiracion." \
      "No se encontraron certificados individuales (.crt/.pem) en /etc/ssl/certs, /etc/pki/tls/certs ni /etc/letsencrypt/live. Los bundles de CAs del sistema (ca-certificates.crt) se omiten a proposito: son cientos de certificados de terceros, no propios del equipo."
    return 0
  fi

  {
    printf 'Archivo\tCN\tFechaExpiracion\tDiasParaExpirar\n'
    local f cn fecha_exp dias
    printf '%s\n' "$archivos" | while IFS= read -r f; do
      [ -n "$f" ] || continue

      cn="$(ejecutar_comando 5 openssl x509 -noout -subject -nameopt multiline -in "$f" 2>/dev/null \
        | awk -F= '/commonName/ { gsub(/^ +| +$/, "", $2); print $2; exit }')"
      [ -n "$cn" ] || cn="N/D"

      fecha_exp="$(ejecutar_comando 5 openssl x509 -noout -enddate -in "$f" 2>/dev/null | sed 's/^notAfter=//')"
      dias="N/D"
      if [ -n "$fecha_exp" ]; then
        local epoch_exp epoch_ahora
        epoch_exp="$(ejecutar_comando 5 date -d "$fecha_exp" +%s 2>/dev/null)"
        epoch_ahora="$(date -u +%s 2>/dev/null)"
        if [ -n "$epoch_exp" ] && [ -n "$epoch_ahora" ]; then
          dias=$(( (epoch_exp - epoch_ahora) / 86400 ))
        fi
      fi
      [ -n "$fecha_exp" ] || fecha_exp="N/D"

      printf '%s\t%s\t%s\t%s\n' "$(tsv_escape "$f")" "$(tsv_escape "$cn")" "$(tsv_escape "$fecha_exp")" "$dias"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Certificados TLS Instalados" \
    "Certificados TLS propios del equipo (no los bundles de CAs de terceros) en las rutas habituales, con su Common Name y dias para expirar." \
    "$archivo"
}

