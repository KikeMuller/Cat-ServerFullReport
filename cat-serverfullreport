  # por posicion.
  local _generados=()
  case " ${FORMATOS[*]} " in
    *" HTML "*)
      medir_seccion "Generacion de HTML" generar_html "$archivo_html"
      _generados+=("$archivo_html") ;;
  esac
  case " ${FORMATOS[*]} " in
    *" JSON "*)
