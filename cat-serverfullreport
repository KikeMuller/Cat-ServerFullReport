# =============================================================================
# REGION: COLECTOR - Actualizaciones Pendientes (1.2.3)
# =============================================================================
#
# Equivalente Linux de "Actualizaciones de Windows Faltantes". Opt-in via
# --include-missing-updates, mismo criterio que -IncludeMissingUpdates en la
# version Windows: consultarlo puede ser lento (sobre todo dnf/yum, que
# golpean red contra los repos configurados) y no escala en modo flota.

recolectar_actualizaciones_pendientes() {
  local id="1.2.3" archivo="$TMPDIR_TRABAJO/sec_1_2_3.tsv"

  if [ "${INCLUDE_MISSING_UPDATES:-0}" != "1" ]; then
    agregar_seccion_mensaje "$id" "Actualizaciones Pendientes" \
      "Paquetes con una version mas nueva disponible en los repositorios configurados, marcando cuales vienen de un canal de seguridad." \
      "Seccion omitida por rendimiento: consultar actualizaciones pendientes puede tardar (dnf/yum consultan los repos por red) y no escala en modo flota. Para incluirla, volver a ejecutar el script agregando --include-missing-updates."
    return 0
  fi

  local gestor="${CAPS[pkg_manager]:-}"
  if [ -z "$gestor" ]; then
    agregar_seccion_mensaje "$id" "Actualizaciones Pendientes" \
      "Paquetes con una version mas nueva disponible en los repositorios configurados." \
      "No se detecto un gestor de paquetes conocido en este equipo."
    return 0
  fi

  local salida=""
  case "$gestor" in
    apt|apt-get)
      # Con root, refrescar el indice de paquetes primero: sin esto, la
      # lista sale contra lo que haya en cache (puede tener dias/semanas),
      # dando falsos negativos sobre parches publicados despues del ultimo
      # refresco. "apt-get update" requiere red y escribe en
      # /var/lib/apt/lists (root); sin privilegios se omite ese paso y se
      # lista igual contra el cache existente, con la advertencia en la
      # nota de la seccion.
      if [ "${CAPS[es_root]:-0}" = "1" ]; then
        ejecutar_comando 60 apt-get update >/dev/null 2>&1
      fi
      salida="$(ejecutar_comando 30 apt list --upgradable 2>/dev/null | tail -n +2)"
      ;;
    dnf|yum)
      # No probado en vivo contra un RHEL/Fedora real en esta sesion (los
      # equipos de prueba disponibles son Debian/Ubuntu). OJO documentado
      # para quien lo pruebe primero: "dnf/yum check-update" sale con
      # codigo 100 (no 0) cuando SI hay actualizaciones disponibles -- 0
      # significa "no hay nada pendiente" y 1 es un error real. Por eso NO
      # se usa "if ! salida=...": un codigo 100 ahi se leeria como fallo y
      # se perderian los datos, aunque la consulta haya funcionado bien.
      salida="$(ejecutar_comando 60 "$gestor" check-update 2>/dev/null | awk 'NF==3 && $1 !~ /^(Last|Obsoleting)/')"
      ;;
    zypper)
      # Tampoco probado en vivo.
      salida="$(ejecutar_comando 60 zypper --non-interactive list-updates 2>/dev/null | awk -F'|' 'NF>=5 && $2 ~ /[a-zA-Z]/ {gsub(/^ +| +$/,"",$3); gsub(/^ +| +$/,"",$5); print $3 "\t" $5}')"
      ;;
    *)
      agregar_seccion_mensaje "$id" "Actualizaciones Pendientes" \
        "Paquetes con una version mas nueva disponible en los repositorios configurados." \
        "El gestor de paquetes detectado ($gestor) no tiene un metodo de consulta de actualizaciones implementado en esta version."
      return 0
      ;;
  esac

  if [ -z "$salida" ]; then
    agregar_seccion_mensaje "$id" "Actualizaciones Pendientes" \
      "Paquetes con una version mas nueva disponible en los repositorios configurados." \
      "Sin actualizaciones pendientes en el momento de la consulta (o no se pudo determinar)."
    return 0
  fi

  {
    printf 'Paquete\tOrigen\tVersionNueva\tEsDeSeguridad\n'
    case "$gestor" in
      apt|apt-get)
        printf '%s\n' "$salida" | awk -F'[ /]' 'NF>=3 {
          paquete=$1; origen=$2; version=$3
          es_seg = (origen ~ /security/) ? "Si" : "No"
          print paquete "\t" origen "\t" version "\t" es_seg
        }'
        ;;
      dnf|yum)
        printf '%s\n' "$salida" | awk '{
          paquete=$1; version=$2; repo=$3
          es_seg = (repo ~ /security/) ? "Si" : "No"
          print paquete "\t" repo "\t" version "\t" es_seg
        }'
        ;;
      zypper)
        printf '%s\n' "$salida" | awk -F'\t' '{ print $1 "\tzypper\t" $2 "\tN/D" }'
        ;;
    esac
  } > "$archivo"

  agregar_seccion_tabla "$id" "Actualizaciones Pendientes" \
    "Paquetes con una version mas nueva disponible en los repositorios configurados ($gestor). 'EsDeSeguridad' se infiere de si el canal/repo del paquete contiene 'security' en el nombre; es una heuristica, no una clasificacion oficial del proveedor." \
    "$archivo"
}

# =============================================================================
# REGION: MOTOR DE HALLAZGOS - Actualizaciones Pendientes
# =============================================================================

motor_regla_actualizaciones() {
  local archivo="${SEC_DATAFILE[1.2.3]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local total_seg total_normal
  total_seg=$(awk -F'\t' 'NR>1 && $4=="Si"' "$archivo" | wc -l)
  total_normal=$(awk -F'\t' 'NR>1 && $4=="No"' "$archivo" | wc -l)

  if [ "$total_seg" -gt 0 ]; then
    if [ "$total_seg" -ge 10 ]; then
      agregar_hallazgo "CRIT" "Mantenimiento" "$total_seg actualizaciones de seguridad pendientes" \
        "Detectadas via el gestor de paquetes del sistema." \
        "Aplicar las actualizaciones de seguridad pendientes lo antes posible." \
        "CIS 1.1 / ISO 27001 A.12.6.1" "1.2.3"
    else
      agregar_hallazgo "WARN" "Mantenimiento" "$total_seg actualizacion(es) de seguridad pendiente(s)" \
        "Detectadas via el gestor de paquetes del sistema." \
        "Planificar la aplicacion de estas actualizaciones de seguridad." \
        "CIS 1.1 / ISO 27001 A.12.6.1" "1.2.3"
    fi
  elif [ "$total_normal" -gt 0 ]; then
    agregar_hallazgo "INFO" "Mantenimiento" "$total_normal actualizacion(es) pendiente(s) (no de seguridad)" "" \
      "Sin apuro de seguridad, pero conviene no acumular demasiado atraso de version." "" "1.2.3"
  else
    agregar_hallazgo "OK" "Mantenimiento" "Sin actualizaciones pendientes" "" \
      "El sistema no tiene actualizaciones pendientes en el momento de la consulta." "CIS 1.1 / ISO 27001 A.12.6.1" "1.2.3"
  fi
}

# =============================================================================
# REGION: COLECTOR - Protocolos y Cifrados TLS del Sistema (1.11.2)
# =============================================================================
#
# Equivalente Linux de "Protocolos, Cifrados y Hashes SChannel" (1.11.2 en
# la version Windows). El mecanismo es distinto: Windows lee llaves de
# registro de SChannel; en Debian/Ubuntu no hay un registro central
# equivalente, asi que se audita lo que SI se puede leer con certeza de la
# configuracion de OpenSSL, la biblioteca que usa la mayoria de servicios
# TLS del sistema salvo que cada uno la sobreescriba.
#
# ADVERTENCIA IMPORTANTE, encontrada durante el desarrollo de esta seccion
# (no se detecto leyendo documentacion, se detecto probando en vivo y
# revisando el resultado antes de confiar en el):
#
#   El primer diseno de esta seccion contaba cuantos cifrados devolvia
#   "openssl ciphers -v" etiquetados como SSLv3/TLSv1/etc, asumiendo que esa
#   etiqueta indicaba si el protocolo estaba habilitado. ES FALSO: esa
#   etiqueta es la GENERACION HISTORICA en la que OpenSSL introdujo ese
#   cifrado, no si el protocolo es negociable hoy. Por ejemplo
#   "DHE-RSA-AES256-SHA" aparece etiquetado "SSLv3" pero funciona
#   perfectamente en una conexion TLS 1.2 real. Con el diseno original, un
#   sistema donde SSLv3 esta genuinamente deshabilitado igual mostraba
#   "14 cifrados SSLv3 disponibles", lo que hubiera generado un WARN falso
#   -- exactamente lo que el principio central de este proyecto prohibe.
#
#   La UNICA forma confiable de saber que protocolos acepta un servicio TLS
#   real es una conexion de prueba real contra el, y este script no levanta
#   ningun listener ni se conecta a servicios de terceros: es de solo
#   lectura. Por eso esta seccion se queda en lo que SI se puede leer con
#   certeza (version de OpenSSL, MinProtocol/CipherString si estan
#   configurados explicitamente, politica RHEL si existe) y NO emite un
#   veredicto de cumplimiento sobre que protocolos estan "habilitados": no
#   hay una regla de hallazgos asociada a esta seccion, a proposito.

recolectar_tls_sistema() {
  local id="1.11.2" archivo="$TMPDIR_TRABAJO/sec_1_11_2.tsv"

  if ! ejecutar_comando 5 which openssl >/dev/null 2>&1; then
    agregar_seccion_mensaje "$id" "Configuracion TLS de OpenSSL" \
      "Version y configuracion de OpenSSL, la biblioteca que usa la mayoria de los servicios TLS del sistema." \
      "openssl no esta instalado en este equipo."
    return 0
  fi

  local version_openssl
  version_openssl="$(ejecutar_comando 5 openssl version 2>/dev/null)"
  [ -n "$version_openssl" ] || version_openssl="N/D"

  # MinProtocol/CipherString en [system_default_sect] de openssl.cnf: la
  # unica forma DOCUMENTADA de fijar explicitamente un piso de protocolo a
  # nivel de sistema en OpenSSL 1.1.0+. Si no esta presente (caso mas
  # comun, confirmado en los dos equipos de prueba de esta sesion), el
  # piso real depende de como se compilo el binario de OpenSSL de esa
  # distro -- dato que no se puede leer sin ejecutar el propio binario en
  # una conexion real.
  local archivo_cnf min_protocol="N/D" cipher_string="N/D"
  archivo_cnf="$(ejecutar_comando 5 openssl version -d 2>/dev/null | sed -n 's/.*"\(.*\)"/\1/p')/openssl.cnf"
  if ejecutar_comando 5 test -r "$archivo_cnf" 2>/dev/null; then
    local contenido_cnf
    contenido_cnf="$(ejecutar_comando 5 cat "$archivo_cnf" 2>/dev/null)"
    local v
    v="$(printf '%s\n' "$contenido_cnf" | awk -F'=' '/^[[:space:]]*MinProtocol[[:space:]]*=/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')"
    [ -n "$v" ] && min_protocol="$v"
    v="$(printf '%s\n' "$contenido_cnf" | awk -F'=' '/^[[:space:]]*CipherString[[:space:]]*=/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')"
    [ -n "$v" ] && cipher_string="$v"
  fi

  # update-crypto-policies (DEFAULT/LEGACY/FUTURE/FIPS): exclusivo de la
  # familia RHEL/Fedora, ausente en Debian/Ubuntu. Rama escrita con
  # cuidado contra el formato documentado, no probada en vivo (los dos
  # equipos de prueba de esta sesion son Debian/Ubuntu, no RHEL).
  local politica_rhel="N/D"
  if ejecutar_comando 5 which update-crypto-policies >/dev/null 2>&1; then
    politica_rhel="$(ejecutar_comando 5 update-crypto-policies --show 2>/dev/null)"
    [ -n "$politica_rhel" ] || politica_rhel="N/D"
  fi

  {
    printf 'Campo\tValor\n'
    printf 'VersionOpenSSL\t%s\n' "$(tsv_escape "$version_openssl")"
    printf 'MinProtocol (openssl.cnf)\t%s\n' "$(tsv_escape "$min_protocol")"
    printf 'CipherString (openssl.cnf)\t%s\n' "$(tsv_escape "$cipher_string")"
    printf 'Politica RHEL (update-crypto-policies)\t%s\n' "$(tsv_escape "$politica_rhel")"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Configuracion TLS de OpenSSL" \
    "Version de OpenSSL y piso de protocolo/cifrado configurado explicitamente a nivel de sistema, si lo hay. Sin MinProtocol/CipherString explicitos (el caso mas comun en Debian/Ubuntu), el minimo real depende de como se compilo esa version de OpenSSL, dato que esta herramienta no puede leer con certeza sin abrir una conexion TLS real -- y al ser de solo lectura, no lo hace. Como referencia: OpenSSL 3.x deshabilita TLS 1.0/1.1 por defecto desde su lanzamiento en 2021, salvo reconfiguracion explicita. Equivalente Linux de Protocolos/Cifrados SChannel de la version Windows, con un mecanismo de auditoria necesariamente distinto: no existe un registro central de TLS en Linux como en Windows." \
    "$archivo"
}

main
