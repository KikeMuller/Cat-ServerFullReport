# REGION: MOTOR DE HALLAZGOS - Bloque de Seguridad
# =============================================================================

motor_regla_uid0() {
  local archivo="${SEC_DATAFILE[1.8.1]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local total
  total=$(( $(wc -l < "$archivo") - 1 ))
  [ "$total" -lt 0 ] && total=0

  if [ "$total" -gt 1 ]; then
    local nombres
    nombres="$(awk -F'\t' 'NR>1{print $1}' "$archivo" | tr '\n' ',' | sed 's/,$//')"
    agregar_hallazgo "CRIT" "Cuentas" "Mas de una cuenta con UID 0" \
      "Cuentas encontradas: $nombres" \
      "Verificar si todas son legitimas. Una cuenta con UID 0 que no sea 'root' es indistinguible de root para el kernel, y debe eliminarse o justificarse formalmente." \
      "CIS 6.2 / ISO 27001 A.9.2" "1.8.1"
  elif [ "$total" -eq 1 ]; then
    agregar_hallazgo "OK" "Cuentas" "Una sola cuenta con privilegios de UID 0" "" \
      "Solo 'root' tiene UID 0, como corresponde." "CIS 6.2 / ISO 27001 A.9.2" "1.8.1"
  fi
  # total == 0 (passwd no legible: en la practica no pasa en un Linux
  # funcionando) queda en silencio: no se afirma nada sobre un dato ausente.
}

motor_regla_ssh() {
  local archivo="${SEC_DATAFILE[1.7]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local permitrootlogin passwordauth
  permitrootlogin="$(awk -F'\t' 'NR>1 && tolower($1)=="permitrootlogin" { print tolower($2); exit }' "$archivo")"
  passwordauth="$(awk -F'\t' 'NR>1 && tolower($1)=="passwordauthentication" { print tolower($2); exit }' "$archivo")"

  if [ -n "$permitrootlogin" ]; then
    if [ "$permitrootlogin" = "no" ]; then
      agregar_hallazgo "OK" "SSH" "Login de root deshabilitado por SSH" "" \
        "PermitRootLogin esta en 'no'." "CIS 5.2.8 / ISO 27001 A.9.2.3" "1.7"
    elif [ "$permitrootlogin" = "yes" ]; then
      agregar_hallazgo "CRIT" "SSH" "Login de root permitido por SSH" \
        "PermitRootLogin=yes" \
        "Deshabilitar el login directo de root por SSH (PermitRootLogin no); usar sudo desde una cuenta nominal." \
        "CIS 5.2.8 / ISO 27001 A.9.2.3" "1.7"
    else
      agregar_hallazgo "WARN" "SSH" "Login de root por SSH parcialmente restringido" \
        "PermitRootLogin=$permitrootlogin" \
        "Revisar si esta restriccion intermedia es la deseada; la mas estricta es 'no'." \
        "CIS 5.2.8" "1.7"
    fi
  fi

  if [ -n "$passwordauth" ]; then
    if [ "$passwordauth" = "yes" ]; then
      agregar_hallazgo "WARN" "SSH" "Autenticacion por contrasena habilitada en SSH" \
        "PasswordAuthentication=yes" \
        "Preferir autenticacion por clave publica y deshabilitar contrasenas (PasswordAuthentication no) donde sea viable." \
        "CIS 5.2.10 / ISO 27001 A.9.4.2" "1.7"
    elif [ "$passwordauth" = "no" ]; then
      agregar_hallazgo "OK" "SSH" "Autenticacion por contrasena deshabilitada en SSH" "" \
        "Solo se permite autenticacion por clave publica." "CIS 5.2.10 / ISO 27001 A.9.4.2" "1.7"
    fi
  fi
}

motor_regla_password_policy() {
  local archivo="${SEC_DATAFILE[1.8.3]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local max_days
  max_days="$(awk -F'\t' 'NR>1 && $1=="PASS_MAX_DAYS" { print $2; exit }' "$archivo")"
  case "$max_days" in
    ''|*[!0-9]*) return 0 ;;   # valor ausente o no numerico: no se afirma nada
  esac

  if [ "$max_days" -gt 365 ]; then
    agregar_hallazgo "WARN" "Cuentas" "Contrasenas sin vencimiento practico para cuentas nuevas" \
      "PASS_MAX_DAYS=$max_days en /etc/login.defs" \
      "Definir una vigencia maxima razonable (por ejemplo 90-180 dias) para cuentas locales nuevas, segun la politica de la organizacion." \
      "CIS 5.4.1.1 / ISO 27001 A.9.4.3" "1.8.3"
  else
    agregar_hallazgo "OK" "Cuentas" "Vigencia maxima de contrasena definida para cuentas nuevas" "" \
      "PASS_MAX_DAYS=$max_days en /etc/login.defs." "CIS 5.4.1.1 / ISO 27001 A.9.4.3" "1.8.3"
  fi
}

motor_regla_mac() {
  local archivo="${SEC_DATAFILE[1.9]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local mecanismo estado
  mecanismo="$(awk -F'\t' 'NR==2{print $1}' "$archivo")"
  estado="$(awk -F'\t' 'NR==2{print $2}' "$archivo")"
  [ -z "$mecanismo" ] && return 0

  if [ "$mecanismo" = "SELinux" ]; then
    if [ "$estado" = "Enforcing" ]; then
      agregar_hallazgo "OK" "Seguridad" "SELinux en modo Enforcing" "" \
        "El control de acceso obligatorio esta activo y aplicando politica." "CIS 1.6 / ISO 27001 A.9.4.1" "1.9"
    elif [ "$estado" = "Permissive" ]; then
      agregar_hallazgo "WARN" "Seguridad" "SELinux en modo Permissive" \
        "SELinux registra violaciones de politica pero no las bloquea." \
        "Pasar a Enforcing una vez validado que no rompe servicios en produccion." \
        "CIS 1.6 / ISO 27001 A.9.4.1" "1.9"
    elif [ "$estado" = "Disabled" ]; then
      agregar_hallazgo "CRIT" "Seguridad" "SELinux deshabilitado" "" \
        "Habilitar SELinux, al menos en modo Permissive como paso intermedio hacia Enforcing." \
        "CIS 1.6 / ISO 27001 A.9.4.1" "1.9"
    fi
  fi
  # Para AppArmor no se emite hallazgo automatico todavia: el numero de
  # perfiles en enforce/complain no alcanza, por si solo, para concluir "bien"
  # o "mal" sin saber que perfiles deberian existir en este equipo puntual.
  # Mejor no afirmar nada que afirmar algo que no se puede sostener.
}

# =============================================================================
# REGION: COLECTORES - Bloque de Red y Storage (1.4.1 - 1.5.2)
# =============================================================================

recolectar_red_interfaces() {
  local id="1.4.1" archivo="$TMPDIR_TRABAJO/sec_1_4_1.tsv"

  local salida
  if ! salida="$(ejecutar_comando 10 ip -o -4 addr show 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Interfaces de Red (IPv4)" \
      "Interfaces de red con sus direcciones IPv4, prefijo y scope." \
      "No se pudo ejecutar 'ip addr show' en este equipo."
    return 0
  fi

  {
    printf 'Interfaz\tDireccionIP\tPrefijo\tBroadcast\tScope\n'
    # "ip -o addr show" da una linea por direccion, con "brd" y "scope" en
    # posicion variable (brd falta en loopback y otras sin broadcast), asi
    # que se buscan como palabras clave en vez de por posicion fija.
    printf '%s\n' "$salida" | awk '{
      iface = $2
      split($4, partes, "/")
      ip = partes[1]; prefijo = partes[2]
      brd = ""; scope = ""
      for (i = 5; i <= NF; i++) {
        if ($i == "brd")   { brd = $(i+1) }
        if ($i == "scope") { scope = $(i+1) }
      }
      if (brd == "")   { brd = "(sin broadcast)" }
      if (scope == "") { scope = "N/D" }
      print iface "\t" ip "\t" prefijo "\t" brd "\t" scope
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Interfaces de Red (IPv4)" \
    "Interfaces de red con sus direcciones IPv4, prefijo de red, direccion de broadcast y scope (host/link/global)." \
    "$archivo"
}

recolectar_red_rutas() {
  local id="1.4.2" archivo="$TMPDIR_TRABAJO/sec_1_4_2.tsv"

  local salida
  if ! salida="$(ejecutar_comando 10 ip route 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Tabla de Rutas" \
      "Rutas IPv4 configuradas: destino, gateway, interfaz de salida y metrica." \
      "No se pudo ejecutar 'ip route' en este equipo."
    return 0
  fi

  {
    printf 'Destino\tGateway\tInterfaz\tOrigen\tMetrica\n'
    printf '%s\n' "$salida" | awk '{
      destino = $1
      gw = ""; dev = ""; src = ""; metric = ""
      for (i = 2; i <= NF; i++) {
        if ($i == "via")    { gw = $(i+1) }
        if ($i == "dev")    { dev = $(i+1) }
        if ($i == "src")    { src = $(i+1) }
        if ($i == "metric") { metric = $(i+1) }
      }
      if (gw == "")     { gw = "(directa)" }
      if (dev == "")    { dev = "N/D" }
      if (src == "")    { src = "N/D" }
      if (metric == "") { metric = "N/D" }
      print destino "\t" gw "\t" dev "\t" src "\t" metric
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Tabla de Rutas" \
    "Rutas IPv4 configuradas: destino, gateway (vacio si la ruta es directa, sin salto intermedio), interfaz de salida, direccion origen y metrica." \
    "$archivo"
}

recolectar_puertos_escucha() {
  local id="1.4.3" archivo="$TMPDIR_TRABAJO/sec_1_4_3.tsv"

  local salida
  if ! salida="$(ejecutar_comando 10 ss -Htulpn 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Puertos en Escucha" \
      "Sockets TCP/UDP en escucha, con direccion/puerto local y el proceso dueno." \
      "No se pudo ejecutar 'ss' en este equipo."
    return 0
  fi

  {
    printf 'Protocolo\tDireccionLocal\tPuerto\tProceso\n'
    # Campos 1-4 (Netid, State, Recv-Q, Send-Q) son siempre un solo token.
    # Campo 5 es "direccion:puerto" pegado (IPv4, IPv6 con corchetes, o "*").
    # El separador real es el ULTIMO ':' del campo: dentro de un IPv6 puede
    # haber muchos otros ':', pero siempre van adentro de los corchetes.
    printf '%s\n' "$salida" | awk '{
      proto = $1
      local = $5
      puerto = local;    sub(/.*:/, "", puerto)
      direccion = local; sub(/:[^:]*$/, "", direccion)
      proc = ""
      for (i = 7; i <= NF; i++) { proc = proc (i > 7 ? " " : "") $i }
      if (proc == "") { proc = "(no determinado, requiere privilegios de root)" }
      print proto "\t" direccion "\t" puerto "\t" proc
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Puertos en Escucha" \
    "Sockets TCP/UDP en escucha, con direccion/puerto local y el proceso dueno. El proceso solo se puede identificar corriendo como root; sin privilegios, esa columna queda marcada como no determinada." \
    "$archivo"
}

recolectar_discos_bloques() {
  local id="1.5.1" archivo="$TMPDIR_TRABAJO/sec_1_5_1.tsv"

  local salida
  if ! salida="$(ejecutar_comando 15 lsblk -Pno NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT 2>/dev/null)"; then
    agregar_seccion_mensaje "$id" "Discos y Particiones (lsblk)" \
      "Dispositivos de bloque: discos, particiones, volumenes LVM/loop y sus puntos de montaje." \
      "No se pudo ejecutar 'lsblk' en este equipo."
    return 0
  fi

  {
    printf 'Nombre\tTamano\tTipo\tSistemaArchivos\tPuntoMontaje\n'
    # Modo -P (pares NAME="valor") en vez de -r (raw, separado por espacios):
    # con -r, una columna vacia en el medio (ej. sin sistema de archivos
    # pero SI con punto de montaje) corre las columnas siguientes una
    # posicion sin avisar, porque awk colapsa espacios repetidos. Con -P
    # cada columna queda entre comillas aunque este vacia, asi que separar
    # por " como campo de awk da posiciones fijas y confiables: $2, $4, $6,
    # $8, $10 son name/size/type/fstype/mountpoint sin ambiguedad, incluso
    # si el punto de montaje tiene espacios adentro.
    printf '%s\n' "$salida" | awk -F'"' '{
      nombre = $2; tamano = $4; tipo = $6; fs = $8; punto = $10
      if (fs == "")    { fs = "(sin formatear)" }
      if (punto == "") { punto = "(sin montar)" }
      print nombre "\t" tamano "\t" tipo "\t" fs "\t" punto
    }'
  } > "$archivo"

  agregar_seccion_tabla "$id" "Discos y Particiones (lsblk)" \
    "Dispositivos de bloque: discos fisicos, particiones, volumenes LVM/loop y sus puntos de montaje. Equivalente Linux de la seccion de Discos Locales de la version Windows." \
    "$archivo"
}

recolectar_cifrado_disco() {
  local id="1.5.2" archivo="$TMPDIR_TRABAJO/sec_1_5_2.tsv"

  # Reusa los datos ya recolectados en 1.5.1 (columna Tipo) en vez de volver
  # a consultar lsblk: evita una llamada remota extra.
  local origen="${SEC_DATAFILE[1.5.1]:-}"
  if [ -z "$origen" ] || [ ! -s "$origen" ]; then
    agregar_seccion_mensaje "$id" "Cifrado de Disco (LUKS)" \
      "Volumenes cifrados con dm-crypt/LUKS. Equivalente Linux de BitLocker en la version Windows." \
      "No se pudo determinar: la seccion de discos y particiones (1.5.1) no genero datos."
    return 0
  fi

  {
    printf 'Dispositivo\tPuntoMontaje\n'
    awk -F'\t' 'NR > 1 && $3 == "crypt" { print $1 "\t" $5 }' "$origen"
  } > "$archivo"

  agregar_seccion_tabla "$id" "Cifrado de Disco (LUKS)" \
    "Volumenes cifrados con dm-crypt/LUKS detectados a partir de lsblk (Tipo=crypt). Equivalente Linux de BitLocker en la version Windows. Una tabla vacia significa que se evaluo el equipo y no se encontro ningun volumen cifrado, no que la deteccion fallo." \
    "$archivo"
}

# =============================================================================
# REGION: MOTOR DE HALLAZGOS - Bloque de Red
# =============================================================================

motor_regla_puertos_sensibles() {
  local archivo="${SEC_DATAFILE[1.4.3]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  # Puertos comunmente sensibles si quedan expuestos en TODAS las interfaces
  # (0.0.0.0/::) en vez de solo en localhost o una interfaz interna.
  local puertos_sensibles="21 23 445 3306 5432 6379 27017 9200"
  local hubo=0
  local linea_num=0
  local proto direccion puerto proceso

  while IFS=$'\t' read -r proto direccion puerto proceso; do
    linea_num=$((linea_num + 1))
    [ "$linea_num" -eq 1 ] && continue

    case "$direccion" in
      '*'|'0.0.0.0'|'[::]'|'::') ;;
      *) continue ;;
    esac

    local p
    for p in $puertos_sensibles; do
      if [ "$puerto" = "$p" ]; then
        agregar_hallazgo "WARN" "Red" "Puerto sensible $puerto en escucha en todas las interfaces" \
          "Protocolo=$proto Direccion=$direccion Proceso=$proceso" \
          "Restringir a localhost o a una interfaz interna si el servicio no necesita exposicion publica; usar el firewall para limitar el origen permitido." \
          "CIS 3.2 / ISO 27001 A.13.1.3" "1.4.3"
        hubo=1
      fi
    done
  done < "$archivo"

  if [ "$hubo" -eq 0 ]; then
    agregar_hallazgo "OK" "Red" "Sin puertos sensibles expuestos en todas las interfaces" "" \
      "Ninguno de los puertos comunmente sensibles (FTP, Telnet, SMB, MySQL, PostgreSQL, Redis, MongoDB, Elasticsearch) esta en escucha en 0.0.0.0/::." \
      "CIS 3.2 / ISO 27001 A.13.1.3" "1.4.3"
  fi
}

