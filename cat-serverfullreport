motor_regla_sysctl() {
  local archivo="${SEC_DATAFILE[1.11]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local hubo=0
  local param valor
  while IFS=$'\t' read -r param valor; do
    [ "$param" = "Parametro" ] && continue
    case "$valor" in
      ''|*[!0-9]*) continue ;;   # N/D o no numerico: no se afirma nada
    esac

    case "$param" in
      net.ipv4.conf.all.rp_filter)
        if [ "$valor" -eq 0 ]; then
          agregar_hallazgo "WARN" "Kernel" "Filtro de ruta inversa (rp_filter) deshabilitado" \
            "net.ipv4.conf.all.rp_filter=0" \
            "Habilitar rp_filter (1 = estricto, 2 = laxo) para dificultar ataques de IP spoofing." \
            "CIS 3.3.1 / ISO 27001 A.13.1.1" "1.11"
          hubo=1
        fi
        ;;
      kernel.randomize_va_space)
        if [ "$valor" -lt 2 ]; then
          agregar_hallazgo "WARN" "Kernel" "ASLR no esta en modo completo" \
            "kernel.randomize_va_space=$valor (esperado: 2)" \
            "Establecer kernel.randomize_va_space=2 para aleatorizacion completa del espacio de direcciones." \
            "CIS 1.5.3 / ISO 27001 A.14.2.5" "1.11"
          hubo=1
        fi
        ;;
      net.ipv4.tcp_syncookies)
        if [ "$valor" -eq 0 ]; then
          agregar_hallazgo "WARN" "Kernel" "Proteccion SYN cookies deshabilitada" \
            "net.ipv4.tcp_syncookies=0" \
            "Habilitar tcp_syncookies para mitigar ataques de agotamiento de conexiones (SYN flood)." \
            "CIS 3.3.3" "1.11"
          hubo=1
        fi
        ;;
    esac
  done < "$archivo"

  if [ "$hubo" -eq 0 ]; then
    agregar_hallazgo "OK" "Kernel" "Parametros de hardening de kernel evaluados en valores esperados" "" \
      "rp_filter, ASLR y tcp_syncookies estan en los valores recomendados." "CIS 3.3 / 1.5" "1.11"
  fi
}

motor_regla_reinicio_pendiente() {
  local archivo="${SEC_DATAFILE[1.12]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local pendiente motivo
  IFS=$'\t' read -r pendiente motivo < <(awk -F'\t' 'NR==2{print $1"\t"$2}' "$archivo")

  if [ "$pendiente" = "Si" ]; then
    agregar_hallazgo "WARN" "Mantenimiento" "Reinicio pendiente" \
      "$motivo" \
      "Planificar una ventana de reinicio: hay actualizaciones (tipicamente de kernel) que no terminaron de aplicarse." \
      "CIS 1.9 / ISO 27001 A.12.6.1" "1.12"
  elif [ "$pendiente" = "No" ]; then
    agregar_hallazgo "OK" "Mantenimiento" "Sin reinicio pendiente" "" \
      "No se detecto ninguna actualizacion esperando un reinicio para completarse." "CIS 1.9" "1.12"
  fi
}

motor_regla_certificados() {
  local archivo="${SEC_DATAFILE[1.13]:-}"
  if [ -z "$archivo" ] || [ ! -s "$archivo" ]; then
    return 0
  fi

  local linea_num=0
  local f cn fecha dias
  while IFS=$'\t' read -r f cn fecha dias; do
    linea_num=$((linea_num + 1))
    [ "$linea_num" -eq 1 ] && continue

    case "$dias" in
      ''|N/D|*[!0-9-]*) continue ;;   # no se pudo calcular: no se afirma nada
    esac

    if [ "$dias" -lt 0 ]; then
      agregar_hallazgo "CRIT" "Certificados" "Certificado expirado: $cn" \
        "Archivo=$f Expiro=$fecha (hace $((-dias)) dias)" \
        "Renovar el certificado de inmediato; un certificado vencido rompe TLS para cualquier cliente que valide la cadena." \
        "ISO 27001 A.10.1.1" "1.13"
    elif [ "$dias" -lt 30 ]; then
      agregar_hallazgo "CRIT" "Certificados" "Certificado por expirar en menos de 30 dias: $cn" \
        "Archivo=$f Expira=$fecha (en $dias dias)" \
        "Renovar el certificado antes de la fecha de expiracion." \
        "ISO 27001 A.10.1.1" "1.13"
    elif [ "$dias" -lt 90 ]; then
      agregar_hallazgo "WARN" "Certificados" "Certificado por expirar en menos de 90 dias: $cn" \
        "Archivo=$f Expira=$fecha (en $dias dias)" \
        "Planificar la renovacion." \
        "ISO 27001 A.10.1.1" "1.13"
    fi
  done < "$archivo"
}

