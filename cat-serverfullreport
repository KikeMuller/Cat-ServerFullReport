# =============================================================================
# REGION: EXPORTADORES (JSON, Markdown)
# =============================================================================
#
# Mismo esquema que el exportador JSON de la version Windows (Get-ServerFullReport),
# a proposito: es lo que permite que una sola herramienta externa (por ejemplo
# para comparar contra un baseline) sirva para los reportes de ambas
# plataformas sin distinguir el origen.
#
# Regla dura de este proyecto que aplica igual aca: armar el JSON a mano con
# printf, nunca con jq/python/awk -- ver la nota de dependencias en el
# encabezado del script. Y las filas TSV se leen SIEMPRE con dividir_tsv, no
# con "IFS=$'\t' read -r a b c": un campo vacio en el medio (el "Detalle" de
# muchos hallazgos, por ejemplo) corre las columnas siguientes y deja datos
# bajo la clave equivocada sin que se note.
#
# TODOS los valores de Data/Findings salen como string JSON, incluso los que
# parecen numericos ("221.1M", "N/D", vacio): emitir un numero desnudo desde
# un valor que puede venir vacio o con formato libre es como se rompe un JSON
# "valido" a mano. Los unicos numeros reales del documento son RowCount, los
# contadores de FindingsSummary, PuntajeSalud y TiempoTotalSegundos.

exportar_json_seccion() {
  # exportar_json_seccion <id> <es_ultima_seccion 0|1>
  # Imprime el objeto JSON de UNA seccion (sin la coma final si es la ultima
  # del arreglo Sections). Separado de exportar_json solo por legibilidad.
  local id="$1" es_ultima="$2"
  local titulo="${SEC_TITLE[$id]}" nota="${SEC_NOTE[$id]}"
  local rowcount="${SEC_ROWCOUNT[$id]}"
  local ismsg="${SEC_ISMSG[$id]}"

  printf '    {\n'
  json_escape "$id";     printf '      "Id": "%s",\n' "$JSON_ESC"
  json_escape "$titulo"; printf '      "Title": "%s",\n' "$JSON_ESC"
  json_escape "$nota";   printf '      "Note": "%s",\n' "$JSON_ESC"
  printf '      "RowCount": %d,\n' "$rowcount"

  if [ "$ismsg" = "1" ]; then
    printf '      "IsMessage": true,\n'
    json_escape "${SEC_MSG[$id]}"
    printf '      "Message": "%s",\n' "$JSON_ESC"
    printf '      "Data": []\n'
  else
    printf '      "IsMessage": false,\n'
    printf '      "Message": null,\n'

    local archivo="${SEC_DATAFILE[$id]}"
    if [ "$rowcount" -gt 0 ] && [ -s "$archivo" ]; then
      printf '      "Data": [\n'

      local columnas=() _linea_enc
      IFS= read -r _linea_enc < "$archivo"
      dividir_tsv "$_linea_enc"
      columnas=("${CAMPOS[@]}")

      # Tipo de enmascarado por columna, calculado UNA vez por tabla, igual
      # que en tabla_html_desde_tsv: es el mismo requisito de --redact, solo
      # que aca el destino es un objeto JSON en vez de una celda <td>.
      local tipos_col=() c_nombre
      for c_nombre in "${columnas[@]}"; do
        tipo_columna "$c_nombre"
        tipos_col+=("$TIPO_COL")
      done

      local n_col=${#columnas[@]}
      local linea_num=0 _linea filas_emitidas=0
      while IFS= read -r _linea; do
        linea_num=$((linea_num + 1))
        [ "$linea_num" -eq 1 ] && continue
        dividir_tsv "$_linea"
        filas_emitidas=$((filas_emitidas + 1))

        printf '        {\n'
        local idx=0 celda
        for celda in "${CAMPOS[@]}"; do
          [ "$idx" -ge "$n_col" ] && break
          if [ "${REDACT:-0}" = "1" ]; then
            enmascarar_valor "$celda" "${tipos_col[$idx]:-ninguno}"
            celda="$VALOR_ENMASCARADO"
          fi
          json_escape "${columnas[$idx]}"; local col_esc="$JSON_ESC"
          json_escape "$celda";            local val_esc="$JSON_ESC"
          idx=$((idx + 1))
          if [ "$idx" -lt "$n_col" ]; then
            printf '          "%s": "%s",\n' "$col_esc" "$val_esc"
          else
            printf '          "%s": "%s"\n' "$col_esc" "$val_esc"
          fi
        done
        if [ "$filas_emitidas" -lt "$rowcount" ]; then
          printf '        },\n'
        else
          printf '        }\n'
        fi
      done < "$archivo"

      printf '      ]\n'
    else
      printf '      "Data": []\n'
    fi
  fi

  if [ "$es_ultima" = "1" ]; then
    printf '    }\n'
  else
    printf '    },\n'
  fi
}

exportar_json() {
  # exportar_json <ruta_salida>
  local salida="$1"
  local hostname fecha_gen usuario
  hostname="${CAPS[hostname]:-EQUIPO}"
  fecha_gen="$(date '+%Y-%m-%dT%H:%M:%S')"
  # Mismo criterio de construir_footer para "quien genero esto" -- ver el
  # comentario extenso alla: "id -un" primero, variables de entorno como
  # respaldo, porque USER/LOGNAME faltan en cron/systemd/sudo -n y pueden
  # mentir despues de un "su" sin guion.
  usuario="$(ejecutar_comando 5 id -un 2>/dev/null)"
  [ -n "$usuario" ] || usuario="${USER:-${LOGNAME:-N/D}}"

  local c_crit=0 c_warn=0 c_info=0 c_ok=0 c_total=0 puntaje
  if [ -s "$FINDINGS_TSV" ]; then
    c_total=$(wc -l < "$FINDINGS_TSV")
    c_crit=$(awk -F'\t' '$1=="CRIT"' "$FINDINGS_TSV" | wc -l)
    c_warn=$(awk -F'\t' '$1=="WARN"' "$FINDINGS_TSV" | wc -l)
    c_info=$(awk -F'\t' '$1=="INFO"' "$FINDINGS_TSV" | wc -l)
    c_ok=$(awk -F'\t' '$1=="OK"' "$FINDINGS_TSV" | wc -l)
  fi
  # Mismo criterio de puntaje que generar_html: parte de 100, descuenta 12
  # por CRIT y 4 por WARN, piso 0. INFO/OK no descuentan.
  puntaje=$((100 - c_crit * 12 - c_warn * 4))
  [ "$puntaje" -lt 0 ] && puntaje=0

  local redact_json="false"
  [ "${REDACT:-0}" = "1" ] && redact_json="true"

  {
    printf '{\n'

    printf '  "Metadata": {\n'
    json_escape "$SCRIPT_VERSION";              printf '    "ScriptVersion": "%s",\n' "$JSON_ESC"
    json_escape "$hostname";                    printf '    "ComputerName": "%s",\n' "$JSON_ESC"
    json_escape "$fecha_gen";                   printf '    "FechaGeneracion": "%s",\n' "$JSON_ESC"
    json_escape "${usuario} en ${hostname}";    printf '    "GeneradoPor": "%s",\n' "$JSON_ESC"
    printf '    "Formato": "JSON",\n'
    json_escape "$PARAMETROS_USADOS";           printf '    "ParametrosUsados": "%s",\n' "$JSON_ESC"
    printf '    "Redactado": %s,\n' "$redact_json"
    printf '    "TiempoTotalSegundos": %s\n' "${TIEMPO_TOTAL_SEGUNDOS:-0}"
    printf '  },\n'

    printf '  "Capabilities": {\n'
    local caps_keys=()
    mapfile -t caps_keys < <(printf '%s\n' "${!CAPS[@]}" | sort)
    local n_caps=${#caps_keys[@]} i_caps=0 k_caps
    for k_caps in "${caps_keys[@]}"; do
      i_caps=$((i_caps + 1))
      json_escape "$k_caps";         local k_esc="$JSON_ESC"
      json_escape "${CAPS[$k_caps]}"; local v_esc="$JSON_ESC"
      if [ "$i_caps" -lt "$n_caps" ]; then
        printf '    "%s": "%s",\n' "$k_esc" "$v_esc"
      else
        printf '    "%s": "%s"\n' "$k_esc" "$v_esc"
      fi
    done
    printf '  },\n'

    printf '  "Findings": ['
    if [ "$c_total" -gt 0 ]; then
      printf '\n'
      local idx_f=0
      awk -F'\t' 'BEGIN{OFS="\t"; r["CRIT"]=0; r["WARN"]=1; r["INFO"]=2; r["OK"]=3} { rk = ($1 in r) ? r[$1] : 9; print rk, $0 }' "$FINDINGS_TSV" \
        | sort -t "$(printf '\t')" -k1,1n -k3,3 \
        | cut -f2- \
        | while IFS= read -r _linea_h; do
            dividir_tsv "$_linea_h"
            local sev="${CAMPOS[0]:-}" cat="${CAMPOS[1]:-}" item="${CAMPOS[2]:-}"
            local det="${CAMPOS[3]:-}" rec="${CAMPOS[4]:-}" ctrl="${CAMPOS[5]:-}"
            local secref="${CAMPOS[6]:-}"
            if [ "${REDACT:-0}" = "1" ]; then
              # Solo el detalle se enmascara, igual que en el HTML: el titulo,
              # la recomendacion y el control son texto generico.
              enmascarar_texto_libre "$det"; det="$VALOR_ENMASCARADO"
            fi
            idx_f=$((idx_f + 1))
            printf '    {\n'
            json_escape "$sev";    printf '      "Severity": "%s",\n' "$JSON_ESC"
            json_escape "$cat";    printf '      "Category": "%s",\n' "$JSON_ESC"
            json_escape "$item";   printf '      "Item": "%s",\n' "$JSON_ESC"
            json_escape "$det";    printf '      "Detail": "%s",\n' "$JSON_ESC"
            json_escape "$rec";    printf '      "Recommendation": "%s",\n' "$JSON_ESC"
            json_escape "$ctrl";   printf '      "Control": "%s",\n' "$JSON_ESC"
            json_escape "$secref"; printf '      "SectionRef": "%s"\n' "$JSON_ESC"
            if [ "$idx_f" -lt "$c_total" ]; then
              printf '    },\n'
            else
              printf '    }\n'
            fi
          done
      printf '  ]'
    else
      printf ']'
    fi
    printf ',\n'

    printf '  "FindingsSummary": {\n'
    printf '    "Crit": %d,\n' "$c_crit"
    printf '    "Warn": %d,\n' "$c_warn"
    printf '    "Info": %d,\n' "$c_info"
    printf '    "Ok": %d,\n' "$c_ok"
    printf '    "Total": %d,\n' "$c_total"
    printf '    "PuntajeSalud": %d\n' "$puntaje"
    printf '  },\n'

    printf '  "Sections": [\n'
    local n_sec=${#SECTION_ORDER[@]} i_sec=0 id_sec
    for id_sec in "${SECTION_ORDER[@]}"; do
      i_sec=$((i_sec + 1))
      if [ "$i_sec" -eq "$n_sec" ]; then
        exportar_json_seccion "$id_sec" "1"
      else
        exportar_json_seccion "$id_sec" "0"
      fi
    done
    printf '  ]\n'

    printf '}\n'
  } > "$salida"

  # Saneado final de bytes no validos en UTF-8, en UNA sola pasada sobre el
  # archivo terminado.
  #
  # Por que solo el JSON y no el HTML: la especificacion de JSON EXIGE UTF-8
  # valido, asi que un solo byte invalido hace que un parser estricto
  # (json.load de Python, muchos ingestores de CMDB) rechace el archivo
  # completo -- se pierde el reporte entero, no una celda. Un navegador, en
  # cambio, tolera esos bytes y solo muestra un caracter raro.
  #
  # De donde salen esos bytes: en Linux los nombres de archivo son cadenas de
  # BYTES, no texto UTF-8 garantizado, y lo mismo vale para descripciones de
  # paquetes o mensajes del journal de una aplicacion mal portada. LC_ALL=C
  # hace que las herramientas emitan ASCII, pero no sanea el CONTENIDO
  # ajeno que esas herramientas reportan.
  #
  # Nota honesta: este caso se observo al probar en Git Bash sobre Windows
  # (el stub de python3 responde en la codificacion ANSI de la consola). NO
  # se reprodujo en el servidor Linux de prueba; la salvaguarda esta por la
  # razon de arriba, que es estructural, no por un fallo medido en Linux.
  #
  # iconv -c descarta los bytes invalidos. Es parte de glibc, pero puede
  # faltar en distros con musl (Alpine): si no esta, se deja el archivo tal
  # cual en vez de perderlo, igual que cualquier otra degradacion del script.
  if ejecutar_comando 5 which iconv >/dev/null 2>&1; then
    local tmp_json="$salida.utf8"
    ejecutar_comando 30 iconv -f UTF-8 -t UTF-8 -c "$salida" > "$tmp_json" 2>/dev/null
    # NO se evalua el codigo de salida de iconv A PROPOSITO: con -c, iconv
    # sale con codigo 1 cuando DESCARTO bytes invalidos, que es precisamente
    # el caso de exito de esta salvaguarda (medido: un archivo de 42 bytes con
    # un 0xf3 salio con codigo 1, 41 bytes y UTF-8 ya valido). La primera
    # version de este bloque usaba "if iconv ... && [ -s ]", asi que
    # descartaba el archivo saneado y conservaba el invalido exactamente
    # cuando hacia falta. Mismo patron que systemd-detect-virt en
    # detectar_capacidades: salida util con codigo distinto de cero.
    #
    # En vez del codigo de salida se valida la FORMA del resultado: un JSON
    # completo termina con la llave de cierre. Eso descarta un truncamiento
    # (timeout, disco lleno) sin depender de un codigo que miente.
    if [ -s "$tmp_json" ] && [ "$(tail -c 2 "$tmp_json" | tr -d '\n')" = "}" ]; then
      mv -f "$tmp_json" "$salida"
    else
      rm -f "$tmp_json"
    fi
  fi
}

MD_ESC=""

markdown_escapar_celda() {
  # Escapa una celda para una tabla Markdown y deja el resultado en MD_ESC,
  # sin imprimir (mismo patron que html_escapar_var/json_escape). Dos cosas
  # rompen una tabla Markdown si no se tocan: un '|' literal (se confunde con
  # un separador de columna) y un salto de linea (corta la fila a la mitad).
  MD_ESC="$1"
  MD_ESC="${MD_ESC//$'\r'/}"
  MD_ESC="${MD_ESC//$'\n'/ }"
  MD_ESC="${MD_ESC//|/\\|}"
}

markdown_tabla_desde_tsv() {
  # markdown_tabla_desde_tsv <archivo_tsv>
  # Imprime una tabla Markdown completa (encabezado, separador y filas) a
  # partir de un TSV con linea de encabezado. Aplica --redact igual que
  # tabla_html_desde_tsv: tipo de columna calculado una vez, enmascarado
  # celda a celda.
  local archivo="$1"

  local columnas=() _linea_enc
  IFS= read -r _linea_enc < "$archivo"
  dividir_tsv "$_linea_enc"
  columnas=("${CAMPOS[@]}")

  local tipos_col=() c_nombre
  for c_nombre in "${columnas[@]}"; do
    tipo_columna "$c_nombre"
    tipos_col+=("$TIPO_COL")
  done

  local linea_hdr="|" linea_sep="|" c
  for c in "${columnas[@]}"; do
    markdown_escapar_celda "$c"
    linea_hdr="${linea_hdr} ${MD_ESC} |"
    linea_sep="${linea_sep} --- |"
  done
  printf '%s\n%s\n' "$linea_hdr" "$linea_sep"

  local linea_num=0 _linea
  while IFS= read -r _linea; do
    linea_num=$((linea_num + 1))
    [ "$linea_num" -eq 1 ] && continue
    dividir_tsv "$_linea"
    local fila="|" idx=0 celda
    for celda in "${CAMPOS[@]}"; do
      if [ "${REDACT:-0}" = "1" ]; then
        enmascarar_valor "$celda" "${tipos_col[$idx]:-ninguno}"
        celda="$VALOR_ENMASCARADO"
      fi
      markdown_escapar_celda "$celda"
      fila="${fila} ${MD_ESC} |"
      idx=$((idx + 1))
    done
    printf '%s\n' "$fila"
  done < "$archivo"
}

exportar_markdown() {
  # exportar_markdown <ruta_salida>
  local salida="$1"
  local hostname fecha usuario
  hostname="${CAPS[hostname]:-EQUIPO}"
  fecha="$(date '+%Y-%m-%d %H:%M:%S')"
  usuario="$(ejecutar_comando 5 id -un 2>/dev/null)"
  [ -n "$usuario" ] || usuario="${USER:-${LOGNAME:-N/D}}"

  local c_crit=0 c_warn=0 c_info=0 c_ok=0 c_total=0 puntaje
  if [ -s "$FINDINGS_TSV" ]; then
    c_total=$(wc -l < "$FINDINGS_TSV")
    c_crit=$(awk -F'\t' '$1=="CRIT"' "$FINDINGS_TSV" | wc -l)
    c_warn=$(awk -F'\t' '$1=="WARN"' "$FINDINGS_TSV" | wc -l)
    c_info=$(awk -F'\t' '$1=="INFO"' "$FINDINGS_TSV" | wc -l)
    c_ok=$(awk -F'\t' '$1=="OK"' "$FINDINGS_TSV" | wc -l)
  fi
  puntaje=$((100 - c_crit * 12 - c_warn * 4))
  [ "$puntaje" -lt 0 ] && puntaje=0

  {
    printf '# Reporte As-Built - %s\n\n' "$hostname"
    printf 'Generado el %s por %s en %s. Version del script: %s.' \
      "$fecha" "$usuario" "$hostname" "$SCRIPT_VERSION"
    if [ "${REDACT:-0}" = "1" ]; then
      printf ' **Reporte enmascarado (--redact): direcciones IP, cuentas, rutas de directorios personales y numeros de serie estan parcialmente ocultos.**'
    fi
    printf '\n\n'

    printf '## Resumen\n\n'
    printf 'Puntaje de salud: **%d/100**\n\n' "$puntaje"
    printf '| Criticos | Advertencias | Informativos | Correcto | Total |\n'
    printf '| --- | --- | --- | --- | --- |\n'
    printf '| %d | %d | %d | %d | %d |\n\n' "$c_crit" "$c_warn" "$c_info" "$c_ok" "$c_total"

    printf '## Hallazgos\n\n'
    if [ "$c_total" -eq 0 ]; then
      printf 'Sin hallazgos registrados en esta ejecucion.\n\n'
    else
      printf '| Severidad | Categoria | Hallazgo | Detalle | Recomendacion | Control | Seccion |\n'
      printf '| --- | --- | --- | --- | --- | --- | --- |\n'
      awk -F'\t' 'BEGIN{OFS="\t"; r["CRIT"]=0; r["WARN"]=1; r["INFO"]=2; r["OK"]=3} { rk = ($1 in r) ? r[$1] : 9; print rk, $0 }' "$FINDINGS_TSV" \
        | sort -t "$(printf '\t')" -k1,1n -k3,3 \
        | cut -f2- \
        | while IFS= read -r _linea_h; do
            dividir_tsv "$_linea_h"
            local sev="${CAMPOS[0]:-}" cat="${CAMPOS[1]:-}" item="${CAMPOS[2]:-}"
            local det="${CAMPOS[3]:-}" rec="${CAMPOS[4]:-}" ctrl="${CAMPOS[5]:-}"
            local secref="${CAMPOS[6]:-}"
            if [ "${REDACT:-0}" = "1" ]; then
              enmascarar_texto_libre "$det"; det="$VALOR_ENMASCARADO"
            fi
            markdown_escapar_celda "$sev";    local m_sev="$MD_ESC"
            markdown_escapar_celda "$cat";    local m_cat="$MD_ESC"
            markdown_escapar_celda "$item";   local m_item="$MD_ESC"
            markdown_escapar_celda "$det";    local m_det="$MD_ESC"
            markdown_escapar_celda "$rec";    local m_rec="$MD_ESC"
            markdown_escapar_celda "$ctrl";   local m_ctrl="$MD_ESC"
            markdown_escapar_celda "$secref"; local m_secref="$MD_ESC"
            printf '| %s | %s | %s | %s | %s | %s | %s |\n' \
              "$m_sev" "$m_cat" "$m_item" "$m_det" "$m_rec" "$m_ctrl" "$m_secref"
          done
      printf '\n'
    fi

    local id_md
    for id_md in "${SECTION_ORDER[@]}"; do
      printf '## %s - %s\n\n' "$id_md" "${SEC_TITLE[$id_md]}"
      local nota_md="${SEC_NOTE[$id_md]}"
      [ -n "$nota_md" ] && printf '_%s_\n\n' "$nota_md"

      if [ "${SEC_ISMSG[$id_md]}" = "1" ]; then
        printf '%s\n\n' "${SEC_MSG[$id_md]}"
      else
        local rowcount_md="${SEC_ROWCOUNT[$id_md]}"
        if [ "$rowcount_md" -gt 0 ]; then
          markdown_tabla_desde_tsv "${SEC_DATAFILE[$id_md]}"
          printf '\n'
        else
          printf 'Sin datos disponibles.\n\n'
        fi
      fi
    done
  } > "$salida"
}

