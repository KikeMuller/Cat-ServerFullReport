      [ -n "$inactiva" ] || inactiva="N/D"
      printf '%s\t%s\t%s\t%s\n' "$(tsv_escape "$u")" "$(tsv_escape "$ultimo")" "$(tsv_escape "$vence")" "$(tsv_escape "$inactiva")"
    done
  } > "$archivo"

  agregar_seccion_tabla "$id" "Usuarios Locales" \
    "Cuentas de usuario locales (UID 1000-59999) con su vigencia de contrasena individual, via chage. Complementa la politica global por defecto de la seccion 1.8.3: una cuenta puede tener valores propios distintos de esa politica." \
